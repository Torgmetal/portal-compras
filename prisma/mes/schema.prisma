// ══════════════════════════════════════════════════════════════════════════════
// TORG MES — SCHEMA PRÓPRIO, CLIENTE PRÓPRIO, SCHEMA `mes` NO POSTGRES
//
// ⚠⚠ POR QUE UM SEGUNDO SCHEMA PRISMA, E NÃO `multiSchema` NO DO PORTAL (Codex, 20-21/09/2026).
// Ligar `multiSchema` obriga `@@schema` em TODO model e TODO enum do arquivo — medido no portal:
// 218 models + 21 enums. Seriam 239 anotações num arquivo que 40 pessoas-mês de trabalho já
// encostam, para separar 14 tabelas. O cliente próprio entrega a mesma fronteira sem tocar em
// nada do portal.
//
// ⚠⚠ O ISOLAMENTO É EM DOIS NÍVEIS, E ELES RESPONDEM PERGUNTAS DIFERENTES:
//   1. **schema `mes` no Postgres** — separa o MES do PORTAL. Um `DROP TABLE` errado aqui não
//      alcança `PecaConjunto`; um backup/restore do MES não arrasta o portal junto.
//   2. **coluna `ambiente`** — separa DEMO de PROD DENTRO do MES. Ver `lib/mes/ambiente.js`.
//
// ⚠ A conexão é o MESMO banco Neon, com `schema=mes` na URL (`lib/mes/prisma.js`) — não é outro
// servidor. Matheus (21/09/2026): "dois sistemas que se integram nativamente".
//
// ⚠⚠ NENHUMA FK PARA TABELA DO PORTAL, E ISSO JÁ ERA REGRA ANTES DE SEPARAR. `funcionarioId`,
// `opId` e `pecaId` são String sem `@relation`, para o MES poder rodar amanhã num gateway local na
// fábrica, com banco próprio. Agora deixou de ser disciplina e virou impossibilidade: o cliente do
// MES nem enxerga aquelas tabelas.
// Quem lê a programação do portal (`PecaConjunto`) faz isso pelo cliente do portal, explicitamente
// — é a fronteira aparecendo no código em vez de morar num acordo.
//
// ⚠ Migração: `scripts/ensure-mes-proprio-tables.mjs`, idempotente, chamado no build. NUNCA
// `prisma db push` contra produção.
// ══════════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
  // ⚠ Saída própria: o cliente do portal continua em `node_modules/.prisma/client`. Dois
  // `generate` no mesmo destino fariam o último apagar o outro.
  output   = "../../node_modules/.prisma/mes-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MES_DATABASE_URL")
}

// execução é o MES.
//
// ⚠⚠ `ambiente` EM TUDO QUE É FATO (sessão, evento, quantidade). DEMO nunca
// projeta pro operacional nem soma em relatório. É o isolamento do laboratório
// por DADO, já que o banco é o mesmo.
//
// ⚠ O modelo copia o acerto do Syneco: o EVENTO é um INSTANTE (`ocorridoEm`),
// não um intervalo. A duração de um estado é o tempo até o próximo evento do
// recurso. Assim OEE, tempo decorrido e paradas caem todos da mesma fonte.
// ══════════════════════════════════════════════════════════════════════════════

// SETOR — tabela, não string, porque vai ter tela de criar/excluir (Matheus, 10/09/2026:
// "precisamos ter essas telas depois para criar e excluir setores, máquinas dos setores/bancadas").
//
// ⚠⚠ `ordem` É A CADEIA FÍSICA DA FÁBRICA, e é dado justamente por isso. Hoje ela é um array fixo
// no código (`CADEIA_SYNECO` em lib/conjuntos-setor.js: Montagem → Solda → Acabamento → Jato →
// Pintura), e é essa sequência que decide o que é "adiantado" e o que é "furo de apontamento".
// Setor criado por tela precisa poder entrar no meio da cadeia sem alguém editar um array.
model MesSetor {
  id        String   @id @default(cuid())
  /// "PREPARACAO", "MONTAGEM" — a chave estável. O nome muda; esta não.
  codigo    String   @unique
  nome      String // "Preparação", "Montagem"
  ordem     Int // posição na cadeia física: 10, 20, 30…
  cor       String? // para o monitor e o Gantt
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recursos MesRecurso[]

  @@index([ativo])
  @@index([ordem])
}

model MesRecurso {
  id           String   @id @default(cuid())
  /// ⚠⚠ A CHAVE É A DO GANTT, NÃO A DO SYNECO. "SOLDA 5", "MONTAGEM 1", "LASER_CHAPA" — é o que
  /// `PecaConjunto.soldaBancada`/`montagemBancada`/`maquina` já gravam, então é por aqui que o
  /// totem acha o que o PCP programou. O Syneco chamaria esta mesma bancada de "40E".
  /// ⚠⚠ ÚNICO POR AMBIENTE, NÃO GLOBAL (21/09/2026). Com `@unique` solto, "SOLDA 5" só podia
  /// existir uma vez no banco inteiro — e DEMO e PROD disputavam a mesma linha, a mesma trava de
  /// sessão aberta e o mesmo crachá. Ver `@@unique([codigo, ambiente])` no fim do model.
  codigo       String
  /// Como a fábrica chama: "Wilson Barros", "Jurandir", "Laser Chapa". Vitor batizou as bancadas
  /// com o nome de quem senta nelas — quem distribui trabalho fala em pessoa, não em código.
  nome         String
  /// ⚠ SÓ PARA RECONCILIAR ENQUANTO OS DOIS RODAM EM PARALELO ("40E", "09"). Morre com o Syneco;
  /// nada de lógica nova deve depender dele.
  codigoSyneco String?
  setorId      String
  tipo         String   @default("MAQUINA") // MAQUINA | BANCADA | POSTO
  ativo        Boolean  @default(true)
  temTerminal  Boolean  @default(true)
  ambiente     String   @default("PROD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  setor        MesSetor         @relation(fields: [setorId], references: [id])
  sessoes      MesSessao[]
  eventos      MesEvento[]
  presencas    MesPresenca[]
  dispositivos MesDispositivo[]

  @@unique([codigo, ambiente])
  @@index([setorId])
  @@index([ativo])
  @@index([ambiente])
  @@index([codigoSyneco])
}

model MesOperador {
  id            String   @id @default(cuid())
  /// ⚠⚠ ÚNICO POR AMBIENTE — mesmo motivo do código do recurso. Global, o mesmo crachá não podia
  /// existir no laboratório e na fábrica, e a trava "um crachá ativo por vez" era compartilhada:
  /// simular a entrada de um operador o expulsaria do posto real.
  cracha        String // o que o leitor bipa
  nome          String // desnormalizado: o histórico não pode mudar se o cadastro mudar
  funcionarioId String? // -> Funcionario.id (sem FK, ver cabeçalho)
  ativo         Boolean  @default(true)
  ambiente      String   @default("PROD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessoes   MesSessao[]
  eventos   MesEvento[]
  presencas MesPresenca[]

  @@unique([cracha, ambiente])
  @@index([ativo])
  @@index([funcionarioId])
}

// Catálogo de motivos de parada. `planejada` separa o que TIRA do tempo planejado
// (refeição, manutenção programada) do que conta contra a Disponibilidade.
model MesMotivoParada {
  id        String   @id @default(cuid())
  codigo    String   @unique
  descricao String
  planejada Boolean  @default(false)
  cor       String? // para o monitor
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventos MesEvento[]

  @@index([ativo])
}

// SESSÃO = o operador produzindo uma marca num recurso. Abre e fecha.
//
// ⚠ Encerrar a sessão NÃO é concluir a OP: a sessão pode produzir parte do
// saldo, e o restante continua disponível para a próxima.
/// O CRACHÁ ATIVO NUM POSTO — quem está operando o quê, AGORA.
///
/// ⚠⚠ NÃO SE INFERE DE `MesSessao.operadorId` (achado do Codex, 13/09/2026, e era exatamente o que
/// eu ia fazer). Aquele campo é AUTORIA DA ABERTURA: quem abriu a marca. Como "quem chega depois
/// entra na sessão que já existe", a sessão que o Jurandir abriu continua com o nome dele mesmo
/// depois de ele ir embora e o Rodrigo assumir a máquina — então inferir presença dali prenderia o
/// Jurandir fora da fábrica inteira por uma máquina que ele não opera mais, e ao mesmo tempo não
/// representaria o Rodrigo, que está lá. São duas perguntas diferentes e precisam de dois
/// registros.
///
/// ⚠⚠ PRESENÇA ≠ ESTADO DA MÁQUINA. Esta tabela responde ONDE O OPERADOR ESTÁ VINCULADO; os
/// `MesEvento` respondem EM QUE ESTADO A MÁQUINA ESTÁ. Foi o erro que já custou caro neste módulo
/// (abrir marca apagava parada) e não se repete aqui: nada nesta tabela é usado para inferir
/// estado produtivo, e nenhum evento libera um vínculo.
model MesPresenca {
  id          String    @id @default(cuid())
  operadorId  String
  recursoId   String
  status      String    @default("ABERTA") // ABERTA | ENCERRADA
  /// Por que o vínculo terminou: "saiu" | "posto ocioso" | "liberada por <quem>".
  motivoFim   String?
  abertaEm    DateTime  @default(now())
  encerradaEm DateTime?
  ambiente    String    @default("PROD")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  operador MesOperador @relation(fields: [operadorId], references: [id])
  recurso  MesRecurso  @relation(fields: [recursoId], references: [id])

  // ⚠⚠ UM CRACHÁ ATIVO POR VEZ — `("operadorId") WHERE status = 'ABERTA'`, índice PARCIAL no
  // Postgres, que o Prisma não sabe declarar; mora em scripts/ensure-mes-tables.mjs
  // (`travaDoCrachaAtivo`). É ELE a regra de verdade: sem o índice, dois totens bipando o mesmo
  // crachá ao mesmo tempo criariam dois vínculos e o operador ficaria "em duas máquinas".
  //
  // ⚠ Não há exclusividade inversa: VÁRIOS operadores podem estar no MESMO posto (turno que se
  // sobrepõe, dois na mesma bancada). O pedido é "um operador não pode estar em duas máquinas",
  // não "uma máquina não pode ter dois operadores".
  @@index([operadorId, status])
  @@index([recursoId, status])
  @@index([abertaEm])
}

model MesSessao {
  id              String    @id @default(cuid())
  recursoId       String
  operadorId      String?
  // Contexto produtivo. A marca NÃO é única globalmente — a chave é obra + marca
  // (+ operação), por isso `opId`/`opNumero` andam junto e nunca a marca sozinha.
  opId            String? // -> OP.id
  opNumero        String? // "T112A56" (código da obra no chão de fábrica)
  marca           String?
  pecaId          String? // -> PecaConjunto.id, quando resolvido
  operacao        String? // etapa/setor da vez
  /// ⚠⚠ A IDENTIDADE DO TRABALHO: "89|T89A16" (obra só em dígitos + marca), ou "—" quando o
  /// operador abriu a máquina sem marca. É ela que a trava de unicidade usa — ver
  /// `lib/mes/chave-trabalho.js` e o índice parcial em `scripts/ensure-mes-tables.mjs`.
  chaveTrabalho   String    @default("—")
  /// ⚠⚠ SÃO LISTAS, NÃO UM CAMPO SÓ — e o motivo apareceu na primeira prova contra o banco
  /// (13/09/2026): a MESMA marca pode estar em duas barras do mesmo plano abertas ao mesmo tempo, e
  /// a sessão é uma só (a trava é por obra+marca). Guardando um `loteId` único, encerrar a barra 2
  /// fecharia a marca que a barra 3 ainda está cortando. Aqui a sessão acumula os comandos que a
  /// usam, e só fecha quando o último deles termina — foi o que o Codex chamou de "encerrar as
  /// sessões daquela execução que não estejam sendo usadas por outra unidade ainda ativa".
  lotes           String[]
  nestingUnidades String[]
  planejadoQtd    Float     @default(0)
  status          String    @default("ABERTA") // ABERTA | ENCERRADA | CANCELADA
  abertaEm        DateTime  @default(now())
  encerradaEm     DateTime?
  ambiente        String    @default("PROD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recurso      MesRecurso          @relation(fields: [recursoId], references: [id])
  operador     MesOperador?        @relation(fields: [operadorId], references: [id])
  eventos      MesEvento[]
  apontamentos MesApontamentoQtd[]

  @@index([lotes])
  // ⚠⚠ UM TRABALHO ABERTO POR RECURSO — `(recursoId, chaveTrabalho) WHERE status = 'ABERTA'`,
  // índice PARCIAL no Postgres, que o Prisma não sabe declarar; mora em
  // scripts/ensure-mes-tables.mjs (`travaDoTrabalhoNoRecurso`), igual ao da
  // ConferenciaPeca. Sem ele, dois totens abrem a MESMA marca duas vezes no mesmo
  // posto e ninguém percebe: os apontamentos se dividem entre as duas sessões e o
  // monitor mostra a máquina em dois estados.
  //
  // ⚠⚠ ERA `("recursoId")` SOZINHO — uma sessão por recurso — e mudou em 13/09/2026,
  // quando o Matheus pediu "multi marcas ao mesmo tempo numa máquina" (o nesting abre
  // todas as marcas da barra de uma vez). A chave ganhou a OBRA por achado do Codex:
  // `(recurso, marca)` misturaria a T97A16 da 097 com a da 102.
  @@index([recursoId, status])
  @@index([opId])
  @@index([opNumero, marca])
  @@index([abertaEm])
  @@index([ambiente])
}

// EVENTO = transição de estado, num INSTANTE. Fato imutável.
model MesEvento {
  id         String   @id @default(cuid())
  recursoId  String
  sessaoId   String?
  operadorId String?
  tipo       String // PRODUCAO | SETUP | PARADA | RETRABALHO | MANUTENCAO | FORA_TURNO | ENCERRAMENTO
  motivoId   String? // obrigatório na prática quando tipo = PARADA
  origem     String   @default("TERMINAL") // TERMINAL | IOT | CORRECAO | SIMULADOR
  // ⚠ DOIS RELÓGIOS, de propósito: `ocorridoEm` é quando aconteceu na fábrica;
  // `recebidoEm` é quando o servidor soube. Com fila offline e coletor atrasado
  // os dois divergem, e misturar os dois é o que faz OEE mentir.
  ocorridoEm DateTime
  recebidoEm DateTime @default(now())
  // Idempotência: mesmo clique/retry/sinal repetido = um efeito só.
  chaveIdem  String?
  sequencia  Int? // sequência do dispositivo, quando houver
  detalhe    String?
  ambiente   String   @default("PROD")
  createdAt  DateTime @default(now())

  recurso  MesRecurso       @relation(fields: [recursoId], references: [id])
  sessao   MesSessao?       @relation(fields: [sessaoId], references: [id])
  operador MesOperador?     @relation(fields: [operadorId], references: [id])
  motivo   MesMotivoParada? @relation(fields: [motivoId], references: [id])

  @@unique([recursoId, chaveIdem])
  @@index([recursoId, ocorridoEm])
  @@index([sessaoId])
  @@index([tipo])
  @@index([ocorridoEm])
  @@index([ambiente])
}

// QUANTIDADE = incremento explícito. Nunca acumulado, nunca implícito.
//
// ⚠ Rejeito não é peça boa e retrabalho não é produção nova — três colunas
// separadas, e quem soma decide o que quer somar.
model MesApontamentoQtd {
  id            String   @id @default(cuid())
  sessaoId      String
  operadorId    String?
  boas          Float    @default(0)
  rejeitadas    Float    @default(0)
  retrabalho    Float    @default(0)
  unidade       String   @default("UN") // UN | KG
  origem        String   @default("TERMINAL")
  // Mesma chave de idempotência da Conferência de Peça: o front gera uma por
  // TENTATIVA e só troca depois do sucesso, então reenviar não duplica.
  chaveOperacao String?
  observacao    String?
  ocorridoEm    DateTime @default(now())
  ambiente      String   @default("PROD")
  createdAt     DateTime @default(now())

  sessao MesSessao @relation(fields: [sessaoId], references: [id])

  @@unique([sessaoId, chaveOperacao])
  @@index([sessaoId])
  @@index([ocorridoEm])
  @@index([ambiente])
}

// COLETOR de sinal. Hoje o Syneco usa módulo USB no PC do terminal; a proposta
// é migrar pra Modbus TCP (ver docs/mes-proprio.md §8).
//
// ⚠⚠ CONECTIVIDADE É DIMENSÃO SEPARADA DO ESTADO PRODUTIVO. Coletor mudo NÃO é
// máquina parada — o monitor mostra o último estado conhecido com a idade do
// dado, e nunca inventa "parado" por falta de sinal.
model MesDispositivo {
  id              String    @id @default(cuid())
  recursoId       String
  nome            String
  tipo            String    @default("MODBUS_TCP") // MODBUS_TCP | USB | SIMULADOR
  host            String? // IP, quando em rede
  porta           Int? // 502 no Modbus TCP
  config          Json? // mapa de registradores/variáveis: Spindle, CycleCount...
  ativo           Boolean   @default(true)
  estadoConexao   String    @default("DESCONHECIDO") // CONECTADO | ATRASADO | DESCONECTADO | DESCONHECIDO
  ultimoContatoEm DateTime?
  ambiente        String    @default("PROD")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  recurso MesRecurso @relation(fields: [recursoId], references: [id])

  @@index([recursoId])
  @@index([ativo])
}

// CORREÇÃO — o fato original nunca é apagado. Guarda o antes/depois e o motivo,
// espelhando o que as procs MCA_Correcao_* do Syneco faziam de certo.
model MesCorrecao {
  id          String   @id @default(cuid())
  entidade    String // MesEvento | MesApontamentoQtd | MesSessao
  entidadeId  String
  campo       String
  valorAntes  String?
  valorDepois String?
  motivo      String
  userId      String? // -> User.id (quem corrigiu no portal)
  criadoEm    DateTime @default(now())

  @@index([entidade, entidadeId])
  @@index([criadoEm])
}

// ─── NESTING DA PREPARAÇÃO (§12) ──────────────────────────────────────────────
//
// O plano de corte do programador. ⚠⚠ NÃO É UMA NOVA LISTA DO QUE PRODUZIR (§3.2): é um
// AGRUPAMENTO FÍSICO de marcas que já existem em `PecaConjunto`. Item que não casar com marca
// conhecida vira pendência visível — nunca entra calado.
model MesNesting {
  id          String  @id @default(cuid())
  /// Como o programador chama o plano — na prática, o nome do arquivo do relatório.
  nome        String
  origem      String // TUBEST | LIBELLULA
  /// "TubesT 2025V2.12", lido de dentro do próprio arquivo da máquina.
  programa    String?
  /// O texto de "Section:" (perfil) ou material+espessura. Serve para conferir, não para casar.
  descricao   String?
  material    String?
  espessuraMm Float?
  recursoId   String?
  /// A OP tirada do nome do arquivo. ⚠ É PISTA, não chave — quem decide é o casamento das marcas.
  opNumero    String?

  arquivoRelatorio String
  arquivoMaquina   String?
  // ⚠⚠ O HASH DOS DOIS, JUNTOS, É O QUE AMARRA A VERSÃO DO PLANO. O relatório e o arquivo da
  // máquina sozinhos não provam ser da mesma versão — e é dessa premissa que depende a dedução do
  // nome da peça curta (§12.8.2). Replano = conteúdo diferente = plano NOVO.
  hashRelatorio    String
  hashMaquina      String?
  /// Os avisos da conciliação, congelados no momento do import — o recibo, não uma previsão.
  divergencias     Json?

  ambiente  String   @default("PROD")
  criadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  unidades MesNestingUnidade[]

  @@unique([hashRelatorio, ambiente])
  @@index([opNumero])
  @@index([recursoId])
}

/// Uma BARRA (perfil/tubo) ou uma CHAPA (laser chapa) — a unidade que o operador aponta.
/// ⚠ No TubesT "Nest 1, 2, 3…" são BARRAS, não chapas (§12.7): cada uma tem o seu arquivo.
model MesNestingUnidade {
  id             String  @id @default(cuid())
  nestingId      String
  indice         Int
  tipo           String  @default("BARRA") // BARRA | CHAPA
  pecas          Int     @default(0)
  comprimentoMm  Float?
  sobraMm        Float?
  aproveitamento Float?
  arquivoMaquina String?

  nesting MesNesting       @relation(fields: [nestingId], references: [id], onDelete: Cascade)
  itens   MesNestingItem[]

  @@unique([nestingId, indice])
}

/// Uma marca dentro de uma barra/chapa.
/// ⚠⚠ A QUANTIDADE É POR UNIDADE, NÃO O TOTAL DO PLANO (§12.3). Total = por unidade × unidades
/// cortadas, sempre derivado: guardar o total obrigaria a dividir de volta a cada apontamento, e
/// divisão que não fecha em inteiro é onde nascem as meias-peças.
model MesNestingItem {
  id             String  @id @default(cuid())
  unidadeId      String
  marca          String
  qtd            Int     @default(0)
  /// Posição na ordem de corte, quando o arquivo da máquina a entrega.
  ordem          Int?
  /// ⚠ Peça SEM GRAVAÇÃO, nomeada por cruzamento com o relatório (§12.8.2). Viaja até a tela de
  /// propósito: peça deduzida é peça para conferir no olho.
  deduzida       Boolean @default(false)
  /// Nulo = não casou com nenhuma marca do portal. É pendência, e a tela mostra.
  pecaConjuntoId String?
  opNumero       String?

  unidade MesNestingUnidade @relation(fields: [unidadeId], references: [id], onDelete: Cascade)

  @@index([unidadeId])
  @@index([marca])
  @@index([pecaConjuntoId])
}

/// A TRILHA DO MES — a 14ª tabela, nascida junto com o schema próprio.
///
/// ⚠⚠ A AUDITORIA DA PASSAGEM DE POSTO PRECISA SER ATÔMICA COM A PASSAGEM (Codex, 20-21/09/2026),
/// e com dois clientes o `AuditLog` do portal deixa de servir para isso: `tx.auditLog.create`
/// dentro da transação do MES passaria a ser uma escrita em OUTRA conexão, em outro schema — a
/// transação voltaria atrás e o carimbo ficaria de pé, ou o contrário. A regra que `carimbarNaTx`
/// existe para garantir ("passagem sem trilha derrota o motivo do módulo") só sobrevive se a
/// trilha morar no mesmo schema da transação.
///
/// ⚠ Mesmo formato do `AuditLog` do portal de propósito (`action`, `entity`, `entityId`, `diff`):
/// quem for ler as duas trilhas lado a lado na integração não terá de traduzir campo.
///
/// ⚠ `ambiente` aqui também: trilha de simulação não se mistura com trilha de produção.
model MesAuditoria {
  id        String   @id @default(cuid())
  userId    String? // -> User.id do portal, sem FK (ver cabeçalho)
  action    String
  entity    String
  entityId  String
  diff      Json?
  ambiente  String   @default("PROD")
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@index([ambiente])
}
