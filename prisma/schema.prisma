  @@index([codigo])
}

model CatalogoPerfilEstrutura {
  id        String   @id @default(cuid())
  categoria String // VIGAS_W, PERFIL_HP, TUBO_REDONDO, etc.
  perfil    String // nome do perfil (ex: "W 200 x 26,6")
  pesoKgM   Float // peso kg/m
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoria, perfil])
  @@index([categoria])
  @@index([ativo])
}

model CatalogoProdutoAcessorio {
  id                   String   @id @default(cuid())
  categoria            String // TELHAS, GRADES_DE_PISO, STEEL_DECK, PAINEIS_ISO
  nome                 String
  pesoM2               Float
  espessuraMm          Float?
  fatorDesenvolvimento Float?
  observacao           String?
  ativo                Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([categoria, nome])
  @@index([categoria])
  @@index([ativo])
}

model MesApontamento {
  id            String    @id @default(cuid())
  productionId  Int // NÃO é único por evento — o SKA reaproveita o ProductionID
  dataInicio    DateTime
  dataFim       DateTime?
  obra          String
  opSka         String?
  setor         String?
  maquina       String?
  codigoMaquina String?
  operacao      String?
  descricaoItem String?
  operador      String?
  status        String?
  produzidoUn   Float     @default(0)
  rejeitado     Float     @default(0)
  retrabalhado  Float     @default(0)
  produzidoKg   Float     @default(0)
  opId          String?
  syncRunId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  op            OP?       @relation("MesApontamentosOP", fields: [opId], references: [id])

  // Chave de upsert: (ProductionID + dataInicio). O ProductionID sozinho NÃO
  // identifica o evento — o SKA o reaproveita (mesmo número vira outro
  // apontamento em horário diferente), e o upsert por ProductionID sobrescrevia
  // o anterior → peças sumiam (ex.: corte 1.176kg às 02:11 virava 420kg às 09:02).
  @@unique([productionId, dataInicio])
  @@index([opId])
  @@index([obra])
  @@index([dataInicio])
  @@index([setor])
  @@index([status])
  @@index([productionId])
}

model MesOrdem {
  id            String    @id @default(cuid())
  obra          String
  op            String
  operacao      String
  item          String
  setor         String?
  descItem      String?
  maquina       String?
  operador      String?
  planejadoUn   Float     @default(0)
  produzidoUn   Float     @default(0)
  rejeitadoUn   Float     @default(0)
  saldoUn       Float     @default(0)
  pesoPlanejado Float     @default(0)
  pesoProduzido Float     @default(0)
  saldoRestante Float     @default(0)
  status        String?
  productionId  Int?
  dataInicio    DateTime?
  dataFim       DateTime?
  opId          String?
  syncRunId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([obra, op, operacao, item])
  @@index([obra])
  @@index([setor])
  @@index([status])
  @@index([opId])
}

// Setores "inativos sem produção" no Syneco (IsEnabled=0 e PartCount=0) — etapas
// feitas FORA da fábrica/terceirizadas. Usado SÓ no relatório de furos de
// apontamento, para não acusar falso furo (ex.: Pintura X acima de Montagem 0
// quando Montagem foi feita fora). Sincronizado do banco do Syneco (tabela
// Production) e SUBSTITUÍDO por inteiro a cada sync (self-correcting: se o
// gerente reativar um setor no SSP, ele sai desta lista no próximo sync).
model MesInativo {
  id           String   @id @default(cuid())
  op           String
  item         String
  operacao     String
  atualizadoEm DateTime @default(now())

  @@unique([op, item, operacao])
  @@index([item])
}

model MesSyncLog {
  id          String   @id @default(cuid())
  sucesso     Boolean
  dataInicio  DateTime
  dataFim     DateTime
  totalLinhas Int      @default(0)
  criados     Int      @default(0)
  atualizados Int      @default(0)
  ignorados   Int      @default(0)
  erro        String?
  duracaoMs   Int      @default(0)
  criadoEm    DateTime @default(now())

  @@index([criadoEm])
  @@index([sucesso])
}

// Allowlist do módulo Diretoria (acesso restrito). O dono (vitor@torg.com.br) é
// sempre liberado em código; esta tabela guarda quem ele liberou além dele.
// Nem ADMIN entra sem estar aqui (gate próprio em lib/diretoria.js).
model AcessoDiretoria {
  id               String   @id @default(cuid())
  email            String   @unique
  nome             String?
  liberadoPorEmail String?
  createdAt        DateTime @default(now())
}

// Override manual da data prevista de faturamento por OP (módulo Diretoria).
// Quando existe, prevalece sobre a data automática (cronograma › prazo da OP).
model DiretoriaFaturamentoData {
  id              String   @id @default(cuid())
  opId            String   @unique
  dataFaturamento DateTime
  observacao      String?
  atualizadoPor   String?
  createdAt       DateTime @default(now())
  atualizadoEm    DateTime @updatedAt
}

// Config chave-valor do módulo Diretoria (ex: id "saldoCaixa" = saldo de caixa
// atual, usado como ponto de partida do fluxo de caixa diário).
model DiretoriaConfig {
  id            String   @id
  valor         Float    @default(0)
  observacao    String?
  atualizadoPor String?
  atualizadoEm  DateTime @updatedAt
}

// Conferência/rastreabilidade de lançamentos financeiros (módulo Diretoria):
// marca um título a pagar/receber como conferido ou suspeito, com trilha de quem
// e quando. lancamentoId = id do ContaPagar/ContaReceber (= código do Omie).
model LancamentoConferencia {
  id           String   @id @default(cuid())
  tipo         String // "PAGAR" | "RECEBER"
  lancamentoId String
  situacao     String // "CONFERIDO" | "SUSPEITO"
  observacao   String?
  por          String?
  createdAt    DateTime @default(now())
  em           DateTime @updatedAt

  @@unique([tipo, lancamentoId])
  @@index([tipo, situacao])
}

// Vínculo manual de uma NFS-e emitida na prefeitura (SigissWeb/Conchal), que não
// está no Omie, com um projeto/obra do Omie — para somar no faturado da obra.
model NfseConchalVinculo {
  id           String    @id @default(cuid())
  numero       String // NUM_DOCU_FISCAL
  serie        String // SERIE_DOCU_FISCAL
  codProj      String // projeto Omie vinculado (= obra na tela Faturamento). String: o codProj do Omie estoura INT4.
  projetoNome  String?
  valor        Float     @default(0)
  data         DateTime?
  tomadorNome  String?
  descricao    String?
  vinculadoPor String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([numero, serie])
  @@index([codProj])
}

// Cache do snapshot de Faturamento por obra (dados do Omie), pra a tela não
// consultar o Omie (~40s) a cada acesso. Atualizado no botão "Atualizar" e por
// cron 1x/dia. id fixo "default" (linha única).
model FaturamentoCache {
  id           String   @id
  dados        Json
  atualizadoEm DateTime @default(now())
}

// Espelho das Contas a Pagar do Omie (financas/contapagar). Sincronizado
// incrementalmente (só o que mudou) por cron + botão Atualizar. id = codigo_lancamento_omie.
model ContaPagar {
  id                 String    @id // codigo_lancamento_omie (string)
  fornecedorCodigo   String?
  fornecedorNome     String?
  valor              Float     @default(0)
  valorPago          Float     @default(0)
  dataEmissao        DateTime?
  dataVencimento     DateTime?
  dataPrevisao       DateTime?
  numeroDocumento    String? // ex: "RPS 3300293"
  numeroDocFiscal    String? // NF
  numeroParcela      String?
  numeroPedidoCompra String?
  categoriaCodigo    String?
  categoriaNome      String?
  categoriasRateio   Json? // rateio por categoria [{codigo,nome,valor}] quando o título é distribuído
  projetoCodigo      String?
  tipoDocumento      String? // BOL, etc.
  status             String? // ABERTO/PAGO/ATRASADO/VENCIDO/CANCELADO
  observacao         String?
  contaCorrenteId    String?
  chaveNfe           String?
  detalheCarregado   Boolean   @default(false) // se já buscou observação/pedido via detalhe
  dataAlteracaoOmie  DateTime?
  syncedAt           DateTime  @default(now())

  @@index([dataVencimento])
  @@index([status])
  @@index([fornecedorNome])
  @@index([categoriaNome])
}

// Espelho das Contas a Receber do Omie. Fonte: financas/mf (movimentos
// financeiros, cNatureza="R"), que — diferente de financas/contareceber —
// expõe o saldo em aberto (nValAberto) e o valor recebido (nValPago), captando
// os títulos "recebidos parcialmente". id = nCodTitulo. Sincronizado por cron + botão.
model ContaReceber {
  id                String    @id // nCodTitulo (string)
  clienteCodigo     String?
  clienteNome       String?
  valor             Float     @default(0) // nValorTitulo (total do título)
  valorRecebido     Float     @default(0) // nValPago
  saldo             Float     @default(0) // nValAberto (a receber)
  dataEmissao       DateTime?
  dataVencimento    DateTime?
  dataPrevisao      DateTime?
  numeroDocumento   String? // cNumTitulo (ex: "RPS 45")
  numeroDocFiscal   String? // cNumDocFiscal — NF emitida
  numeroParcela     String?
  numeroPedidoVenda String?
  numeroOS          String? // cNumOS
  categoriaCodigo   String?
  categoriaNome     String?
  projetoCodigo     String?
  tipoDocumento     String? // cTipo (NFS, NFE, BOL...)
  status            String? // A VENCER/ATRASADO/RECEBIDO/CANCELADO (do Omie)
  observacao        String?
  contaCorrenteId   String?
  chaveNfe          String?
  detalheCarregado  Boolean   @default(false)
  dataAlteracaoOmie DateTime?
  syncedAt          DateTime  @default(now())

  @@index([dataVencimento])
  @@index([status])
  @@index([clienteNome])
  @@index([categoriaNome])
}

// Estado do sync incremental por entidade do Omie ("contapagar" / "contareceber").
model OmieSyncState {
  id              String    @id // "contapagar"
  ultimoSync      DateTime?
  ultimaAlteracao DateTime? // maior data de alteração já sincronizada
  totalRegistros  Int       @default(0)
  updatedAt       DateTime  @updatedAt
}

model Recebimento {
  id              String            @id @default(cuid())
  pedidoOmieId    String?
  rmItemId        String?
  qtdRecebida     Float
  unidade         String?
  dataRecebimento DateTime          @default(now())
  nfNumero        String?
  nfChave         String?
  nfSerie         String?
  origem          RecebimentoOrigem @default(MANUAL)
  observacao      String?
  createdById     String?
  createdAt       DateTime          @default(now())
  createdBy       User?             @relation(fields: [createdById], references: [id])
  pedidoOmie      PedidoOmie?       @relation(fields: [pedidoOmieId], references: [id])
  rmItem          RMItem?           @relation(fields: [rmItemId], references: [id])

  @@index([pedidoOmieId])
  @@index([rmItemId])
  @@index([dataRecebimento])
}

// Listas de referência do CMR (autocomplete): DESCRICAO (Descrição Padrão) e NORMA (Normas
// Padrão). Semeadas do import da planilha e crescem com o que o estoque lança.
model CmrReferencia {
  id        String   @id @default(cuid())
  tipo      String // DESCRICAO | NORMA
  valor     String
  usos      Int      @default(0) // quantas vezes foi usado (ordena o autocomplete)
  createdAt DateTime @default(now())

  @@unique([tipo, valor])
  @@index([tipo])
}

model Cronograma {
  id             String               @id @default(cuid())
  opNumero       String
  opId           String?
  nomeArquivo    String
  titulo         String
  sharepointPath String               @unique
  dataInicio     DateTime?
  dataFim        DateTime?
  dataBase       DateTime? // Data base (baseline) — referencia do cronograma
  tipoDias       String               @default("DU") // DU = dias uteis, DC = dias corridos
  areas          Json                 @default("[]") // Áreas da obra: [{nome, cor}] — cor FIXA por área (índice da paleta), estável no rename; definível na criação
  ultimoSync     DateTime             @default(now())
  ativo          Boolean              @default(true)

  // TAREFAS LIBERADAS PROS SETORES — ato deliberado, com botão, DEPOIS que o cronograma está
  // fechado. Vitor (19/08/2026): "minha sugestão seria colocarmos um botão para enviar tarefas em
  // cada cronograma; isso será enviado após a liberação do cronograma, não deve ser preenchido
  // automático, pois algumas estruturas mudam de obra para obra".
  // Enquanto for null, as tarefas existem no cronograma mas NÃO aparecem na Sequência dos setores.
  tarefasEnviadasEm    DateTime?
  tarefasEnviadasPorId String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  op             OP?                  @relation(fields: [opId], references: [id])
  tarefas        CronogramaTarefa[]
  revisoes       CronogramaRevisao[]
  cobrancas      CronogramaCobranca[]
  envios         CronogramaEnvio[]

  @@index([opNumero])
  @@index([ativo])
}

model CronogramaTarefa {
  id                  String                  @id @default(cuid())
  cronogramaId        String
  uidMpp              Int
  nome                String
  departamento        DepartamentoCronograma?
  area                String? // Área/parte da obra (letra, número ou nome) — agrupa tarefas dentro do setor (Setor → Área → Tarefa). Vira summary no XML.
  dataInicioPrevista  DateTime?
  dataFimPrevista     DateTime?
  dataInicioBase      DateTime? // Baseline start (snapshot na data base)
  dataFimBase         DateTime? // Baseline end (snapshot na data base)
  percentualPrevisto  Float                   @default(0)
  percentualRealizado Float                   @default(0)
  qtdePlanejada       Float                   @default(0)
  qtdeRealizada       Float                   @default(0)
  isSummary           Boolean                 @default(false)
  outlineLevel        Int                     @default(0)
  parentUid           Int?
  antecessoraIds      String[]                @default([]) // IDs de tarefas predecessoras (finish-to-start)
  defasagemDias       Int                     @default(0) // Lead/lag vs o fim das antecessoras (DU ou DC). NEGATIVO = antecipação: começa antes da anterior terminar (na prática a gente adianta atividade). Preservado nos recálculos.
  duracaoDias         Int                     @default(0) // Duracao em dias (DU ou DC conforme cronograma)
  dataLiberacao       DateTime? // Data em que a tarefa foi liberada (desbloqueio externo)
  motivoBloqueio      String? // Ex: "Aguardando assinatura do aditivo"
  observacao          String?
  dataRealizacao      DateTime?
  // Execução REAL — não altera as datas previstas/base; o atraso é derivado
  dataInicioReal      DateTime?
  dataFimReal         DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  registros           CronogramaRegistro[]
  cronograma          Cronograma              @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)

  @@index([cronogramaId])
  @@index([departamento])
}

model CronogramaRegistro {
  id          String           @id @default(cuid())
  tarefaId    String
  descricao   String
  createdById String
  createdAt   DateTime         @default(now())
  createdBy   User             @relation("CronogramaRegistroCreatedBy", fields: [createdById], references: [id])
  tarefa      CronogramaTarefa @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId])
}

// Linha de controle — cada alteracao no cronograma gera uma revisao
model CronogramaRevisao {
  id           String     @id @default(cuid())
  cronogramaId String
  tipo         String // BASELINE_DEFINIDA, TAREFA_ALTERADA, SYNC_SHAREPOINT, DATA_ALTERADA
  descricao    String // Descricao legivel da alteracao
  diff         Json? // { campo, antes, depois } ou snapshot
  createdById  String
  createdAt    DateTime   @default(now())
  cronograma   Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  createdBy    User       @relation("CronogramaRevisaoCreatedBy", fields: [createdById], references: [id])

  @@index([cronogramaId])
  @@index([createdAt])
}

// Cobranca por email — cada envio gera um token publico para o setor responder com novas datas
// Envio do cronograma (PDF) pelo portal — pros setores da Torg e/ou pro cliente.
// Espelha a estrutura da CronogramaCobranca. Guarda pra quem foi e quando, pra
// dar rastro de "o cliente já recebeu esta versão?".
model CronogramaEnvio {
  id            String     @id @default(cuid())
  cronogramaId  String
  destinatarios Json       @default("[]") // [{ nome, email, tipo: "SETOR" | "CLIENTE" }]
  mensagem      String?
  assunto       String?
  enviados      Int        @default(0) // quantos e-mails saíram de fato
  createdById   String
  createdAt     DateTime   @default(now())
  cronograma    Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  createdBy     User       @relation("CronogramaEnvioCreatedBy", fields: [createdById], references: [id])

  @@index([cronogramaId])
}

model CronogramaCobranca {
  id             String     @id @default(cuid())
  token          String     @unique @default(cuid())
  cronogramaId   String
  departamento   String
  emailsEnviados String[] // Para quem foi enviado
  tarefaIds      String[] // IDs das tarefas cobradas (atrasadas no momento do envio)
  respondido     Boolean    @default(false)
  respostas      Json? // [{ tarefaId, novaData, comentario }]
  createdById    String
  createdAt      DateTime   @default(now())
  respondidoAt   DateTime?
  respondidoPor  String? // Nome/email de quem respondeu
  cronograma     Cronograma @relation(fields: [cronogramaId], references: [id], onDelete: Cascade)
  createdBy      User       @relation("CobrancaCreatedBy", fields: [createdById], references: [id])

  @@index([cronogramaId])
  @@index([token])
}

// Cobrança dos MARCOS de produção (aba Cobrança das Tarefas). Pode abranger
// marcos de vários cronogramas de um mesmo setor. O setor responde por link
// público: por marco, informa se FINALIZOU (data de conclusão + evidência) ou,
// se não, a NOVA data prevista. É obrigatório responder cada marco.
model CobrancaMarco {
  id             String    @id @default(cuid())
  token          String    @unique @default(cuid())
  departamento   String
  tarefaIds      String[] // CronogramaTarefa (marcos) cobrados
  emailsEnviados String[]
  respondido     Boolean   @default(false)
  respostas      Json? // [{ tarefaId, status, novaData, dataConclusao, evidencia }]
  createdById    String?
  createdAt      DateTime  @default(now())
  respondidoEm   DateTime?
  respondidoPor  String?

  @@index([token])
}

// Ata de reunião semanal (módulo Reuniões). Sequencial + revisão ISO. As
// atividades são atribuídas a setores, que confirmam recebimento por link e
// preenchem informação + evidência.
model AtaReuniao {
  id          String            @id @default(cuid())
  numero      Int // sequencial (ATA-001)
  semanaIso   Int
  ano         Int
  titulo      String
  dataReuniao DateTime?
  status      String            @default("RASCUNHO") // RASCUNHO | ENVIADA | CONCLUIDA
  revisao     Int               @default(0) // R00, R01…
  pauta       String?
  envolvidos  Json              @default("[]") // [{ nome, email, setor }]
  revisoes    Json              @default("[]") // [{ n, motivo, em, por }]
  createdById String?
  enviadaEm   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  atividades  AtaAtividade[]
  confirmacoes AtaConfirmacao[]

  @@index([ano, semanaIso])
  @@index([status])
}

model AtaAtividade {
  id              String     @id @default(cuid())
  ataId           String
  descricao       String
  op              String? // OP relacionada (organização por OP no rascunho da IA)
  setor           String? // setor responsável (pode ficar em branco p/ preencher depois)
  responsavel     String?
  prazo           DateTime?
  origemAtaNumero Int? // arrastada de uma ata anterior (nº da ata de ORIGEM — mantém a mais antiga)
  ehDesdobramento     Boolean @default(false) // tarefa NOVA criada ao responder (desdobramento), ≠ arrastada
  desdobramentoDeDesc String? // descrição da tarefa de origem (rastreio do desdobramento)
  status          String     @default("PENDENTE") // PENDENTE (=atrasada, sem resposta) | EM_ANDAMENTO | CONCLUIDA
  resposta      String? // informação preenchida pelo setor
  evidencia     String? // evidência (texto)
  respondidoPor String?
  respondidoEm  DateTime?
  ordem         Int        @default(0)
  createdAt     DateTime   @default(now())
  ata           AtaReuniao @relation(fields: [ataId], references: [id], onDelete: Cascade)

  @@index([ataId])
}

// Um por envolvido — link público (token) pra confirmar recebimento e ver/preencher a ata.
model AtaConfirmacao {
  id           String     @id @default(cuid())
  ataId        String
  nome         String
  email        String
  setor        String?
  token        String     @unique
  confirmadoEm DateTime?
  createdAt    DateTime   @default(now())
  ata          AtaReuniao @relation(fields: [ataId], references: [id], onDelete: Cascade)

  @@index([ataId])
  @@index([token])
}

model TarefaPlanejamento {
  id                String        @id @default(cuid())
  titulo            String
  descricao         String?
  opNumero          String?
  opId              String?
  setor             String
  semanaIso         Int
  ano               Int
  status            String        @default("PENDENTE")
  prioridade        String        @default("MEDIA")
  responsavel       String?
  dataPrevista      DateTime?
  dataConcluida     DateTime?
  observacao        String?
  // Tarefa de responsabilidade do CLIENTE (ele fornece/aprova). Cobrança/confirmação
  // por e-mail com resposta de 1 clique (token público, sem login).
  doCliente         Boolean       @default(false)
  clienteNome       String?
  clienteEmail      String?
  clienteToken      String?       @unique
  clienteAvisadoEm  DateTime?
  clienteRespostaEm DateTime?
  clienteResposta   String?
  // Token público (sem login) para o SETOR responder o lembrete de 1 clique
  respostaToken     String?          @unique
  // "Aguardando resposta": setado quando o lembrete (pedindo resposta) é enviado;
  // limpo/comparado quando o setor responde — pra saber o que ainda falta cobrar.
  respostaSolicitadaEm DateTime?
  respostaRecebidaEm   DateTime?
  // Checklist de sub-tarefas: [{ id, titulo, feita }]
  subtarefas        Json             @default("[]")
  createdById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdBy         User?         @relation("TarefaPlanejamentoCreatedBy", fields: [createdById], references: [id])
  op                OP?           @relation(fields: [opId], references: [id])
  compromissos      Compromisso[]
  respostas         TarefaResposta[]

  @@index([semanaIso, ano])
  @@index([setor])
  @@index([opId])
  @@index([status])
}

// Registro de cada resposta a uma tarefa do Planejamento (cliente ou setor) —
// alimenta o Painel de Respostas. Cliente responde via clienteToken; setor via
// respostaToken (ambos links públicos de 1 clique no e-mail).
model TarefaResposta {
  id         String             @id @default(cuid())
  tarefaId   String
  origem     String // CLIENTE | SETOR
  autorNome  String?
  autorEmail String?
  tipo       String // CONCLUIDO | NOVA_DATA | COMENTARIO
  novaData   DateTime?
  texto      String?
  createdAt  DateTime           @default(now())
  tarefa     TarefaPlanejamento @relation(fields: [tarefaId], references: [id], onDelete: Cascade)

  @@index([tarefaId])
  @@index([createdAt])
}

// Matriz de comunicação por setor: contatos (nome+e-mail) que recebem as
// tarefas distribuídas pelo Planejamento. 1 registro por setor (setor único).
model ComunicacaoSetor {
  id        String   @id @default(cuid())
  setor     String   @unique
  contatos  Json     @default("[]") // [{ nome, email }]
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Lista Avançada de Expedição importada do SharePoint (1 por frente). marcasJson
// guarda a tabela de marcas parseada (aba PROJETO). Atualizada a cada revisão.
model ListaExpedicao {
  id               String    @id @default(cuid())
  frente           String    @unique // T36, T94A… (ou OP-94 quando o arquivo não tem prefixo)
  opNumero         String?
  opId             String?
  arquivo          String
  revisao          String?
  itemId           String? // id do arquivo no SharePoint (re-download)
  fileModificado   DateTime?
  hash             String? // sha1 do conteúdo (detectar mudança)
  marcas           Int       @default(0)
  qtdItens         Int       @default(0)
  pesoContratado   Float     @default(0)
  pesoExpedido     Float     @default(0)
  pesoFaltante     Float     @default(0)
  expedidasArquivo Int       @default(0)
  marcasJson       Json      @default("[]")
  importadoEm      DateTime  @default(now())
  importadoPorId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([opNumero])
}

// Baixa MANUAL de marca na Lista de Expedição — peça que não vai virar romaneio
// mas precisa sair do "pendente" (não encontrada em obra / adicionada / erro na
// expedição / quantidade divergente). Fica "expedida SEM romaneio", destacada em
// amarelo, com o motivo registrado.
model BaixaExpedicao {
  id          String   @id @default(cuid())
  opId        String
  frente      String?
  marca       String
  motivo      String // NAO_ENCONTRADA | ADICIONADA | ERRO_EXPEDICAO | QTD_DIVERGENTE
  qtd         Float    @default(0)
  pesoKg      Float    @default(0) // peso dado baixa (pra somar no expedido dos cards)
  observacao  String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([opId])
}

// Mudança detectada na Lista de Expedição (nova revisão do arquivo no servidor).
// Guarda o DIFF por marca pra o Planejamento tratar: peça INCLUÍDA precisa entrar
// num lote; peça EXCLUÍDA precisa sair (senão corre-se o risco de expedir peça
// que não existe mais). notificadaEm = e-mail já enviado aos setores.
// Romaneio PRÉVIO: o Planejamento marca as peças prioritárias da Lista de
// Expedição e monta a carga antes de a Expedição emitir o romaneio de verdade.
// Numeração sequencial ao último romaneio EMITIDO da OP. `itens` guarda as
// marcas escolhidas (mesma chave da lista: a marca).
model RomaneioPrevio {
  id           String    @id @default(cuid())
  opId         String
  opNumero     String
  numero       Int
  status        String    @default("PREVISTO") // PREVISTO (em aberto) | APROVADO | CANCELADO
  dataPrevista  DateTime?
  local         String?
  observacao    String?
  itens         Json      @default("[]") // [{ frente, marca, descricao, qte, pesoTotal }]
  pesoKg        Float     @default(0)
  loteId        String? // lote de entrega a que esta carga pertence
  aprovadoEm    DateTime? // aprovado = liberado para a Expedição
  aprovadoPorId String?
  emitidoEm     DateTime? // null = não emitido; setado ao gerar o romaneio consolidado
  emitidoPorId  String?
  revisao       Int       @default(0) // 0 = 1ª emissão (R00); 1+ = revisões (R01, R02…)
  historico     Json      @default("[]") // [{ revisao, emitidoEm, mudanca, porQuem }]
  arquivoUrl    String? // webUrl do FORM 22 no SharePoint (setado na emissão) — link no Fiscal
  // ── Fiscal (aba Fiscal) — emitido cai aqui aguardando NF; finalizado = nº + tipo ──
  nfNumero          String? // número da NF informado pelo dept fiscal
  nfTipo            String? // VENDA | SERVICO | REMESSA
  nfEmitidaEm       DateTime? // quando o dept registrou a NF (= finalizado)
  nfObservacao      String?
  nfRegistradoPorId String?
  // ── Emissão integrada com o Omie (NF Remessa — mesmo fluxo da Remessa Terceiro) ──
  nfPedidoOmie      String? // nCodRem da remessa no Omie
  nfPedidoNumero    String? // cNumeroRemessa no Omie
  nfSerie           String?
  nfChave           String? // chave de acesso da NF-e (44 díg.)
  nfErroEmissao     String? // última msg de erro/aguardando da emissão
  nfFrete           Json? // dados do frete p/ a NF (mesma estrutura da remessa terceiro)
  criadoPorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  op            OP             @relation(fields: [opId], references: [id], onDelete: Cascade)
  lote          LoteExpedicao? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@unique([opId, numero])
  @@index([opId])
}

model ListaExpedicaoRevisao {
  id              String    @id @default(cuid())
  opId            String?
  opNumero        String
  frente          String
  arquivo         String
  revisao         String?
  revisaoAnterior String?
  incluidas       Json      @default("[]")
  excluidas       Json      @default("[]")
  alteradas       Json      @default("[]") // mesma marca, qtd/peso diferente
  nIncluidas      Int       @default(0)
  nExcluidas      Int       @default(0)
  nAlteradas      Int       @default(0)
  detectadaEm     DateTime  @default(now())
  notificadaEm    DateTime?
  resolvidaEm     DateTime?
  resolvidaPorId  String?

  @@index([opNumero])
  @@index([opId])
}

model NecessidadeSemanal {
  id          String   @id @default(cuid())
  semanaIso   Int
  ano         Int
  opNumero    String
  opId        String?
  setor       String
  descricao   String?
  pesoKg      Float    @default(0)
  prioridade  String   @default("MEDIA")
  status      String   @default("PENDENTE")
  observacao  String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("NecessidadeSemanalCreatedBy", fields: [createdById], references: [id])
  op          OP?      @relation(fields: [opId], references: [id])

  @@index([semanaIso, ano])
  @@index([setor])
  @@index([opNumero])
  @@index([status])
}

model ConfigAssistente {
  id                 String   @id @default(cuid())
  ativo              Boolean  @default(true)
  modulosHabilitados String[] @default([])
  modelo             String   @default("claude-haiku-4-5")
  instrucaoExtra     String?
  updatedAt          DateTime @updatedAt
}

enum TipoUsuario {
  ADMIN
  USUARIO
  FUNCIONARIO // acesso de autoatendimento (portal /meu-rh); não passa em módulos internos
}

enum Modulo {
  COMERCIAL
  ENGENHARIA
  COMPRAS
  PRODUCAO
  ALMOXARIFADO
  FINANCEIRO
  EXPEDICAO
  RH
  PLANEJAMENTO
  PCP
  REQUISICOES
  QUALIDADE
  // ⚠⚠ QUALIDADE_CAMPO É O ACESSO DO INSPETOR, e existia só no código.
