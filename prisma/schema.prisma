model PortalListaRevisao {
  id          String    @id @default(cuid())
  opId        String
  opNumero    String
  fonte       String // "LPC" | "LE"
  seq         Int       @default(1)
  // Revisao da ENGENHARIA quando existe ("R02", "T89A R02 - T89B R00"): e o numero que o cliente
  // ve no rodape do projeto. Quando nao existe, a tela cai no seq.
  rotulo      String?
  itens       Int       @default(0)
  pesoKg      Float     @default(0)
  hash        String
  // { marca: [qte, pesoKg] } — a base do PROXIMO diff. Sem ela, a revisao seguinte nao teria
  // contra o que comparar.
  impressao   Json?
  incluidas   Json      @default("[]")
  excluidas   Json      @default("[]")
  alteradas   Json      @default("[]") // mesma marca, qtd ou peso diferente
  nIncluidas  Int       @default(0)
  nExcluidas  Int       @default(0)
  nAlteradas  Int       @default(0)
  publicadaEm DateTime  @default(now())
  // O cliente clicou "entendi" — o alerta para de aparecer pra ele. Nulo = ainda nao viu.
  vistoEm     DateTime?

  @@unique([opId, fonte, seq])
  @@index([opId, fonte])
  @@index([opNumero])
}

model PortalCliente {
  id               String    @id @default(cuid())
  opId             String?
  opNumero         String    @unique
  token            String?   @unique
  status           String    @default("RASCUNHO") // RASCUNHO | PUBLICADO
  contato          String?
  empresa          String?
  clienteEmail     String?
  capaUrl          String?
  // ⚠ O LOGO DO CLIENTE AO LADO DO NOSSO. Vitor (22/08/2026): "quero que tenha o logo da
  // torg e logo do cliente". Não é enfeite: o portal é o documento de uma PARCERIA, e uma
  // página que só carrega a marca de quem fabrica parece propaganda, não prestação de contas.
  logoClienteUrl   String?
  // a mensagem de abertura — agradecimento e parceria, escrita por obra
  mensagem         String?
  // [{ url, legenda }] — as fotos da obra que o cliente vê
  fotos            Json?
  // quais seções aparecem; null = o padrão de lib/portal-cliente.js
  secoes           Json?
  // ⚠ PESO É PREÇO. Vitor (22/08/2026): "a lista LPC e LE deixe a opção de divulgar com e
  // sem peso, isso é importante para nós". Estrutura metálica se cota por R$/kg — publicar
  // o peso item a item entrega a base de cálculo do nosso preço a quem vai negociar o
  // próximo contrato. Nasce DESLIGADO: ligar é uma decisão consciente da obra, e o
  // contrário (descobrir depois que vazou) não tem volta.
  mostrarPeso      Boolean   @default(false)
  publicadoEm      DateTime?
  enviadoEm        DateTime?
  primeiroAcessoEm DateTime?
  ultimoAcessoEm   DateTime?
  acessos          Int       @default(0)
  criadoPorId      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status])
}

