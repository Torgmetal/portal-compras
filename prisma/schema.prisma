// ── PMP — Plano Mestre de Producao ────────────────────────────
// Meta diaria de producao por OP + setor.
// Visao semanal = SUM(metas da semana).
model PmpMeta {
  id          String   @id @default(cuid())
  data        DateTime @db.Date // dia-alvo
  setor       String // CORTE, MONTAGEM, SOLDA, ACABAMENTO, JATO, PINTURA, EXPEDIDO
  opNumero    String // OP
  metaPecas   Int      @default(0) // meta em pecas
  metaPesoKg  Float    @default(0) // meta em kg
  observacao  String?
  criadoPorId String
  criadoPor   User     @relation("PmpMetaCriador", fields: [criadoPorId], references: [id])
  // opNumero é string livre (sem FK): obras do Syneco/LPC (ex.: T60B) podem
  // não estar cadastradas como OP no portal e mesmo assim ter meta no PMP.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([data, setor, opNumero])
  @@index([data])
  @@index([opNumero])
}

model Compromisso {
  id          String              @id @default(cuid())
  titulo      String
  descricao   String?
  data        DateTime
  concluido   Boolean             @default(false)
  concluidoEm DateTime?
  userId      String
  tarefaId    String?
  opNumero    String?
  setor       String?
  prioridade  String              @default("MEDIA")
  criadoPorId String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation("CompromissoUser", fields: [userId], references: [id])
  tarefa      TarefaPlanejamento? @relation(fields: [tarefaId], references: [id])
  criadoPor   User?               @relation("CompromissoCriadoPor", fields: [criadoPorId], references: [id])

  @@index([userId, data])
  @@index([userId, concluido])
  @@index([tarefaId])
}

// Obras ocultadas do Relatório de Produção POR SETOR (ex.: OPs já finalizadas
// num setor). Só some da VISÃO do relatório — nenhum dado é apagado. ADMIN-only.
model RelatorioCorteObraOculta {
  id           String   @id @default(cuid())
  obra         String
  setor        String   @default("CORTE")
  ocultadoPor  String?
  ocultadoNome String?
  criadoEm     DateTime @default(now())

  @@unique([obra, setor])
}

// Baixa manual no Relatório de Produção: OP já finalizada cujo apontamento no
// Syneco ficou incompleto. Marca a obra/setor como 100% concluída SÓ na visão
// do relatório (não altera o Syneco nem o mesOrdem; sobrevive ao sync). ADMIN-only.
model RelatorioObraConcluida {
  id            String   @id @default(cuid())
  obra          String
  setor         String   @default("CORTE")
  concluidoPor  String?
  concluidoNome String?
  criadoEm      DateTime @default(now())

  @@unique([obra, setor])
}

// Prioridades de produção marcadas pelo PCP no Relatório de Produção, POR SETOR.
// O PCP ordena (1º, 2º…) as obras prioritárias de cada setor e estima uma data de
// finalização. Alimenta o Dashboard TV (nº de peças/% concluído vêm ao vivo do
// Syneco/mesOrdem; aqui só guardamos a ordem e o prazo estimado).
model ProducaoPrioridade {
  id           String    @id @default(cuid())
  obra         String
  setor        String    @default("CORTE")
  ordem        Int       @default(0)
  dataEstimada DateTime?
  // Escopo: obra inteira (default) ou só as peças (op codes do mesOrdem) em `pecas`.
  obraInteira  Boolean   @default(true)
  pecas        String[]  @default([])
  criadoPor    String?
  criadoNome   String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @default(now()) @updatedAt

  @@unique([obra, setor])
  @@index([setor, ordem])
}

// Baixa da carteira do Dashboard do PCP: obra/frente (opNumero da PecaConjunto)
// já finalizada, removida da "Necessidade por obra". Só esconde da VISÃO do
// dashboard — não altera o status das peças. Reversível, ADMIN-only.
model PcpCarteiraObraBaixa {
  id          String   @id @default(cuid())
  opNumero    String   @unique
  baixadoPor  String?
  baixadoNome String?
  criadoEm    DateTime @default(now())
}

// Heartbeat dos crons — cada cron registra sua última execução (ok/erro/duração).
// O cron "monitor" lê isto e alerta (e-mail) se algum cron não roda há tempo
// demais ou falhou. Guarda-corpo contra cron morrer silenciosamente.
model CronHeartbeat {
  job       String    @id // ex.: "sync-entregas", "estoque-produtos"
  lastRunAt DateTime  @default(now())
  lastOkAt  DateTime?
  ok        Boolean   @default(true)
  mensagem  String?
  duracaoMs Int?
  updatedAt DateTime  @updatedAt
}

// ── Romaneios Terceirizados (Expedição) ───────────────────────────────────────
// Controle À PARTE (sem vínculo com o romaneio da obra): material enviado a um
// terceiro pra trabalhar (galvanização, usinagem, pintura…) e o seu RETORNO.
// Série de numeração própria (RT-01, RT-02…). Referência à OP é só rastreio
// (opRefId/opRefNumero denormalizados — NÃO liga no fluxo da OP).
model RomaneioTerceiro {
  id                String    @id @default(cuid())
  numero            Int       @unique // série própria RT-##
  // terceiro (Vendor List opcional + nome sempre gravado)
  fornecedorId      String?
  terceiroNome      String
  servico           String? // ex.: galvanização, usinagem, pintura, jato
  // referência opcional à OP (só rastreio)
  opRefId           String?
  opRefNumero       String?
  // transporte
  transportadora    String?
  motorista         String?
  placaVeiculo      String?
  placaCarreta      String?
  contatoTransporte String?
  // peças enviadas (conjuntos/croquis): [{ marca, descricao, qte, pesoUn, pesoTotal }]
  itens             Json      @default("[]")
  pesoEnviadoKg     Float     @default(0)
  // Etapa de onde a peça saiu (CORTE/MONTAGEM/SOLDA/…). Só p/ Corte/Montagem geramos o 2º
  // romaneio de MATERIAL (perfis a cortar), pra NF de retorno. Da Solda em diante, só peças.
  setorEnvio        String?
  // material a mandar (agrupado por perfil): [{ perfil, descricao, qtd, pesoKg }]
  materiais         Json      @default("[]")
  arquivoMaterialUrl String?
  // retornos parciais: [{ id, data, itens:[{marca, qte, pesoTotal}], pesoKg, observacao, porNome }]
  retornos          Json      @default("[]")
  pesoRetornadoKg   Float     @default(0)
  status            String    @default("ENVIADO") // ENVIADO | PARCIAL | RETORNADO | CANCELADO
  dataEnvio         DateTime?
  dataPrevRetorno   DateTime?
  observacao        String?
  arquivoUrl        String?
  // ── Remessa fiscal (NF de remessa p/ industrialização — aba Remessa Terceiro do Fiscal) ──
  // A remessa é PRÉ-CRIADA junto do romaneio (remessaStatus PENDENTE) e emitida no Fiscal.
  remessaStatus     String    @default("PENDENTE") // PENDENTE | EMITIDA | CANCELADA | DISPENSADA
  remessaCfop       String? // 5901 (dentro do estado) / 6901 (fora) — remessa p/ industrialização
  remessaFrete      Json? // dados do frete p/ a NF: { tpFrete, nCodTransp, transpNome, placa, uf, qtdVol, especie, pesoLiq, pesoBruto, valorFrete, valorSeguro, valorOutras }
  remessaErroEmissao String? // última mensagem de erro da emissão (SEFAZ) — some quando autoriza
  remessaNatureza   String? // natureza da operação (ex.: "Remessa para industrialização")
  remessaNfNumero   String?
  remessaNfSerie    String?
  remessaNfChave    String? // chave de acesso (44 díg.)
  remessaNfEmitidaEm DateTime?
  remessaPedidoOmie String? // codigo interno do pedido de venda no Omie (Fase 2 — emissão integrada)
  remessaPedidoNumero String? // nº do pedido de venda no Omie (humano, p/ conferir/faturar lá)
  remessaObservacao String?
  remessaPorNome    String?
  criadoPorId       String?
  criadoNome        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([remessaStatus])
}

// ── Dispensa de documento por funcionário (RH) ────────────────────────────────
// Marca um NR dispensável (NR-10, NR-12, NR-33, NR-35) como NÃO obrigatório para
// um funcionário específico — ele não faz aquela atividade. No compliance o item
// vira DISPENSADO (não conta como AUSENTE/pendência). Denormalizado (sem FK).
model DocumentoDispensa {
  id            String   @id @default(cuid())
  funcionarioId String
  tipo          String // NR_10 | NR_12 | NR_33 | NR_35 (tipos com dispensavel:true)
  motivo        String?
  criadoPorId   String?
  criadoNome    String?
  createdAt     DateTime @default(now())

  @@unique([funcionarioId, tipo])
  @@index([funcionarioId])
}

// Link de acesso externo (token) a PASTAS específicas do SGQ — só leitura, só PDFs.
model CompartilhamentoSGQ {
  id           String    @id @default(cuid())
  token        String    @unique
  nome         String
  mensagem     String?
  pastas       String[]  @default([])
  documentos   String[]  @default([])
  expiraEm     DateTime?
  ativo        Boolean   @default(true)
  criadoPorId  String?
  acessos      Int       @default(0)
  ultimoAcesso DateTime?
  createdAt    DateTime  @default(now())
}

// ── Documentos assináveis (Plano de Treinamentos, Cronograma de Auditoria Interna) ──
// Revisão sobe automático quando o conteúdo muda; envio p/ assinatura por e-mail (token);
// assinatura eletrônica = confirmação + data + IP.
model DocumentoRevisao {
  tipo         String   @id // PLANO_TREINAMENTO | CRONOGRAMA_AUDITORIA
  revisao      Int      @default(0)
  atualizadoEm DateTime @default(now()) @updatedAt
}

model EnvioAssinatura {
  id           String                @id @default(cuid())
  tipo         String
  revisao      Int
  titulo       String
  snapshot     Json                  @default("{}")
  enviadoEm    DateTime              @default(now())
  enviadoPorId String?
  assinaturas  AssinaturaDocumento[]

  @@index([tipo])
}

model AssinaturaDocumento {
  id         String          @id @default(cuid())
  envioId    String
  nome       String
  email      String
  setor      String?
  token      String          @unique
  assinadoEm DateTime?
  ip         String?
  envio      EnvioAssinatura @relation(fields: [envioId], references: [id], onDelete: Cascade)

  @@index([envioId])
}

// PORTAL QUALIDADE FÁBRICA — a foto tirada no celular, no chão de fábrica.
//
// Vitor (21/08/2026): "preciso criar uma forma de que o pessoal da fábrica através de um celular
// tire fotos e faça relatórios; hoje tudo é manual". O celular é só CAPTURA: escolhe a OP e o tipo,
// fotografa e diz de qual peça é. O relatório em si é montado depois, no computador, e é lá que
// começa o fluxo de assinaturas.
//
// ⚠ `origemMarca` não é detalhe. QR é o desenho identificando a peça; BUSCA é uma pessoa afirmando
// qual é. Numa auditoria isso não vale a mesma coisa, então fica registrado qual dos dois foi.
model FotoInspecao {
  id          String   @id @default(cuid())
  opId        String?
  opNumero    String // snapshot: OP.numero é texto ("067", "T60B")
  tipo        String // DIMENSIONAL | VISUAL_SOLDA | LP | PINTURA | MONTAGEM | GERAL
  marca       String? // peça (marca do Tekla). Nulo = foto de região/geral
  origemMarca String? // QR | BUSCA | LIVRE
  observacao  String? // legenda curta digitada no celular
  // SNAPSHOT dos instrumentos que o inspetor marcou na hora: [{id,nome,certificado,validade}].
  // É snapshot de propósito — quando o certificado for renovado, o relatório antigo tem de
  // continuar mostrando o que estava valendo no dia da inspeção, não o de agora.
  equipamentos Json?
  url         String // Vercel Blob (JPEG já reduzido no aparelho)
  tamanho     Int?
  autorId     String?
  autorNome   String?
  capturadaEm DateTime @default(now())
  relatorioId String? // preenchido quando a foto entra num relatório montado no portal
  createdAt   DateTime @default(now())

  @@index([opNumero, tipo])
  @@index([relatorioId])
  @@index([capturadaEm])
}

// RELATÓRIO DE INSPEÇÃO — o que a fábrica fotografou, virando documento.
//
// Vitor (21/08/2026): "não quero que só apareça no pdf, precisa aparecer na estruturação; e
// lembre-se, precisamos solicitar assinatura desses relatórios".
//
// O celular captura (FotoInspecao); aqui as fotos viram um documento numerado, que entra na seção
// do data book como qualquer outro anexo — por isso o `documentoId`: é o DocumentoQualidade que faz
// o relatório aparecer na LISTA da seção, não só no PDF montado no fim.
//
// A assinatura reusa o fluxo genérico (EnvioAssinatura/AssinaturaDocumento + /assinar/[token]), o
// mesmo do Plano de Treinamentos e do Cronograma de Auditoria.
model RelatorioInspecao {
  id       String @id @default(cuid())
  // sequencial POR OBRA e POR TIPO ("de acordo com cada obra, e ser sequencial")
  numero   Int
  codigo   String @unique // RID-067-001
  opId     String?
  opNumero String
  tipo     String // DIMENSIONAL | VISUAL_SOLDA | LP | PINTURA | MONTAGEM | GERAL
  titulo   String?
  // observações do inspetor, escritas no computador ao fechar o relatório
  observacoes String?
  // instrumentos utilizados, consolidados das fotos (e ajustáveis na montagem)
  equipamentos Json?

  // ── DIMENSIONAL ──────────────────────────────────────────────────────────────────────────
  // Vitor (21/08/2026): "pode ser [um por conjunto], mas no caso das peças avulsas podemos
  // agrupá-las para facilitar, pois senão iríamos gerar inúmeros relatórios".
  escopo    String? // CONJUNTO (um desenho) | AVULSAS (várias peças num relatório só)
  marcas    Json? // as marcas cobertas: ["T83A13"] ou ["T83A-P1","T83A-P2",…]
  // linhas da tabela: { marca, descricao, projetoMm, tolerancia, encontradoMm, obs }
  // `projetoMm` vem da LISTA DE MATERIAIS do DESENHO (não da LPC — divergem em 1 mm);
  // `encontradoMm` nasce vazio, é o elaborador que preenche.
  linhas    Json?
  // { dimensional, alinhamento, acabamento, resultado } — os quadros de aprovação do modelo
  resultados Json?
  // desenhos embutidos no PDF: [{ marca, itemId, nome }] — o "CROQUI / FOTO DA PEÇA"
  desenhos  Json?
  status   String @default("RASCUNHO") // RASCUNHO | EMITIDO
  // ⚠ BACKUP NA PASTA DA OBRA. Vitor (22/08/2026): "salvar os relatórios em PDF na pasta
  // da qualidade de cada OP para podermos garantir o backup". O portal não é o arquivo da
  // obra: aqui o PDF é gerado sob demanda, e sem cópia no servidor não sobra papel nenhum
  // se o registro sumir. Guardado na APROVAÇÃO, em 8. Qualidade/3. Relatórios de Inspeção.
  arquivoUrl   String?
  arquivadoEm  DateTime?

  // ── REINSPEÇÃO E REVISÃO ─────────────────────────────────────────────────────────────────
  // Vitor (21/08/2026): "no caso de reprova o relatório deve ficar aberto; na reinspeção o inspetor
  // abre o relatório que estava reprovado e analisa os pontos destacados que foram reprovados, e
  // quando o relatório for aprovado salvar como R01, e se for reprovado novamente nova revisão".
  //
  // Cada RODADA de inspeção é uma revisão: R00 é a primeira. Reprovou, o relatório continua aberto
  // e a rodada seguinte vira R01. Aprovou, fecha na revisão em que estava.
  resultadoInspecao String? // APROVADO | REPROVADO | REC (null = ainda não julgado)
  rncId             String? // a RNC aberta pela reprovação (uma por relatório, reusada nas revisões)
  revisao           Int     @default(0) // 0 = R00
  // as rodadas anteriores, congeladas: [{ revisao, resultadoInspecao, linhas, emEm, por }]
  revisoes          Json?

  emitidoEm DateTime?
  inspetor      String? // quem executou a inspeção (nome que sai no documento)
  criadoPorId   String?
  criadoPorNome String?
  // liga ao fluxo de assinatura genérico (null enquanto não foi enviado)
  envioAssinaturaId String?
  // DocumentoQualidade gerado — é ele que aparece na seção do data book
  documentoId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opNumero, tipo, numero])
  @@index([opNumero])
  @@index([status])
}

// ─── Agente de E-mails da Engenharia (MS Graph Mail) ──────────────────────────
// Lê as caixas da Engenharia (só as 6, travadas por ApplicationAccessPolicy) pra
// saber o start do projeto (IFC etc.), tempo de resposta e quem respondeu.
// Doc: docs/agente-emails-engenharia.md. Fase 1 = ingestão crua (sem casar com OP).
model ObraEmailEvento {
  id                String    @id @default(cuid())
  opId              String? // vínculo com a OP (null enquanto não casou) — Fase 2
  caixa             String // mailbox de origem (qual das 6 caixas da engenharia)
  pasta             String // inbox | sentItems
  conversationId    String? // thread do Graph (amarra 1º e-mail ↔ resposta)
  internetMessageId String    @unique // dedupe idempotente
  graphId           String? // id da mensagem no Graph (referência)
  webLink           String? // link p/ abrir a mensagem no Outlook Web (Graph webLink)
  direcao           String // ENTRADA | SAIDA
  de                String?
  deNome            String?
  para              Json      @default("[]") // [endereços]
  cc                Json      @default("[]")
  assunto           String?
  snippet           String? // bodyPreview (sem corpo inteiro)
  recebidoEm        DateTime?
  enviadoEm         DateTime?
  temAnexo          Boolean   @default(false)
  temAnexoIfc       Boolean   @default(false)
  anexos            Json      @default("[]") // [{ nome, tipo, tamanho }] — metadados só
  tipoGatilho       String? // marco: IFC_RECEBIDO | LIBERACAO_INICIO | PROJETO_ENVIADO | APROVADO_CLIENTE | OUTRO
  marcoFonte        String? // KEYWORD | IA — como o marco foi classificado
  iaChecado         Boolean   @default(false) // já passou pela classificação por IA
  primeiroContato   Boolean   @default(false) // 1º inbound do cliente na thread (Fase 2)
  matchConfianca    Float? // 0..1 (Fase 2)
  matchMetodo       String? // REGRA_OP | CODIGO_OBRA | DOMINIO | NOME_OBRA | IA | MANUAL (Fase 2)
  respondidoEm      DateTime? // 1ª resposta da eng na thread (SLA — Fase 2)
  respondidoPor     String?
  criadoEm          DateTime  @default(now())

  @@index([opId])
  @@index([conversationId])
  @@index([caixa])
  @@index([direcao])
  @@index([recebidoEm])
}

// Controle de delta por caixa/pasta (bookkeeping não-fatal). Guarda o deltaLink do
// Graph pra a próxima sync pegar só o que mudou.
model ObraEmailSync {
  id           String    @id @default(cuid())
  caixa        String
  pasta        String // inbox | sentItems
  deltaLink    String?   @db.Text
  ultimoEm     DateTime?
  ultimoErro   String?
  totalEventos Int       @default(0)
  atualizadoEm DateTime  @updatedAt
  criadoEm     DateTime  @default(now())

  @@unique([caixa, pasta])
}

// A PASTA DA ENGENHARIA, CONFERIDA — resultado gravado da varredura do SharePoint.
//
// Vitor (25/08/2026): "faça rápido". A conferência sob demanda levava minutos por obra e ele teria
// de clicar obra por obra; aqui o cron varre de madrugada e o painel abre com tudo pronto.
//
// ⚠ UMA LINHA POR OP (@unique): é uma foto do estado atual, não histórico. Guardar série temporal
// disso multiplicaria a tabela por dia sem ninguém consultar o passado.
model PastaEngenharia {
  id             String   @id @default(cuid())
  opId           String   @unique
  op             OP       @relation(fields: [opId], references: [id], onDelete: Cascade)
  // OK | PARCIAL | SEM_CONJUNTO | SO_MAQUINA | SEM_DESENHO | SEM_LISTA | VAZIA
  veredito       String
  pdfs           Int      @default(0)
  outrosPdfs     Int      @default(0)
  nc1            Int      @default(0)
  igs            Int      @default(0)
  cliente        Int      @default(0)
  marcas         Int      @default(0)
  conjuntosTotal Int      @default(0)
  conjuntosCom   Int      @default(0)
  croquisTotal   Int      @default(0)
  croquisCom     Int      @default(0)
  foraPadrao     Int      @default(0)
  // semDesenho[], porFormato[], clienteAmostra[] — o que a tabela do detalhe mostra
  detalhe        Json?
  erro           String?
  checadoEm      DateTime @default(now())
  // BAIXA — obra antiga que a Diretoria não quer mais acompanhar aqui. Vitor (25/08/2026): "dar
  // baixa em algumas OPs que são antigas... registrar isso e tirar elas da seleção".
  //
  // ⚠ NÃO é encerrar a OP: a obra segue viva no resto do portal. É só sumir desta lista, com quem
  // deu baixa e por quê — sem o registro, some do painel e ninguém sabe explicar por quê depois.
  baixada        Boolean  @default(false)
  baixadaEm      DateTime?
  baixadaPorNome String?
  baixaMotivo    String?

  @@index([veredito])
  @@index([checadoEm])
  @@index([baixada])
}
