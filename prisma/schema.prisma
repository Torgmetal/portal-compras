// Solicitação de início de produção criada pelo Planejamento a partir das datas
// do cronograma (necessidade do cliente) — uma por obra. As datas necessárias
// por setor ficam em `datasSetor` (JSON { CORTE: "YYYY-MM-DD", ... }). Vai para
// PCP/Produção (notificação) e aparece no PMP para acompanhamento.
model SolicitacaoProducao {
  id             String    @id @default(cuid())
  opNumero       String    @unique
  opId           String?
  cronogramaId   String?
  dataEntrega    DateTime? @db.Date
  datasSetor     Json      @default("{}")
  hhPorTonManual Float? // produtividade informada no Planejamento (sobrepõe o comercial)
  prioridade     String    @default("MEDIA") // ALTA | MEDIA | BAIXA
  status         String    @default("SOLICITADA") // SOLICITADA | EM_PRODUCAO | ATRASADA | CONCLUIDA
  liberadoLpcLe  Boolean   @default(false)
  observacao     String?
  criadoPorId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([opNumero])
}

// GRD — controle de liberação de desenhos pros setores: registro de cada impressão/liberação de
// projeto (PDF da Engenharia no SharePoint) feita pelas telas de produção/PCP. Tabela criada via
// SQL (db push bloqueado por drift); só client gerado a partir daqui.
// TROCA DE RASTREABILIDADE na separação: o Almoxarifado tirou um fardo diferente do R que o
// FIFO indicou (o mais acessível na prateleira). Só existe linha aqui quando houve TROCA — sem
// alteração não há registro nem ação (Vitor 19/08). Uma linha por OP+perfil; regravar atualiza.
// A partir dela o motor de rastreio para de usar o FIFO naquele material e passa a usar o R
// registrado — deixa de ser regra de consumo e vira fato.
model TrocaRastreabilidade {
  id         String   @id @default(cuid())
  opId       String?
  opNumero   String
  perfil     String
  rIndicado  String? // o que o FIFO tinha apontado (fica pra auditoria)
  rUsado     String // o R do fardo efetivamente separado
  motivo     String?
  trocadoPorId   String?
  trocadoPorNome String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([opNumero, perfil])
  @@index([opNumero])
}

model GrdLiberacao {
  id              String   @id @default(cuid())
  opId            String?
  opNumero        String
  marca           String
  arquivo         String // nome do PDF no SharePoint (ex.: T89A1.pdf)
  formato         String? // A1 | A2 | A3 | A4 | A4 (croqui)
  setor           String? // bloco/setor de onde foi liberado (preparacao|montagem|acabamento|PCP)
  itemId          String? // id do arquivo no drive (pra reabrir)
  // Emissão CARIMBADA: o PDF sai do portal com a rastreabilidade do material daquela marca,
  // quem emitiu, data e hora — e o MESMO arquivo é arquivado e amarrado ao Data Book (§02).
  rastreio        Json? // snapshot do casamento de corrida no momento da emissão (prova)
  impressoItemId  String? // item do PDF CARIMBADO no SharePoint (é o que a pessoa abre/imprime)
  impressoUrl     String? // webUrl do carimbado
  documentoId     String? // DocumentoQualidade gerado (entra na §02 do Data Book)
  // GRD só nasce quando o desenho é IMPRESSO (abrir/emitir não é GRD). Reimpressão da mesma
  // marca/arquivo/setor NÃO cria outra GRD: soma aqui, com a data da última. (Vitor 19/08.)
  impressoes      Int      @default(1)
  ultimaImpressaoEm DateTime?
  liberadoPorId   String?
  liberadoPorNome String?
  createdAt       DateTime @default(now())

  @@index([opNumero, marca])
}

// Cache do CADASTRO DE PRODUTOS do Omie (2.4k itens). O portal só enxergava os ~190 itens que já
// passaram por uma RM — por isso perfis existentes no Omie apareciam "sem código" no romaneio de
// terceiro. Sincronizado por cron/botão. Tabela criada via SQL (db push bloqueado por drift).
model ProdutoOmie {
  id           String   @id @default(cuid())
  codigo       String   @unique // código do produto no Omie (ex.: 201000010)
  codigoOmie   String? // nCodProd (id interno do Omie)
  descricao    String
  unidade      String?
  familia      String?
  inativo      Boolean  @default(false)
  atualizadoEm DateTime @default(now())

  @@index([descricao])
}

// OPs fixadas manualmente na TV de Prioridades por setor (as rápidas, sem cronograma).
// Tabela criada via SQL (db push bloqueado por drift); só client gerado a partir daqui.
model PrioridadeTvOp {
  id          String   @id @default(cuid())
  opNumero    String   @unique
  opId        String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([opId])
}

// O CONTRÁRIO da PrioridadeTvOp: OP que NÃO deve aparecer na fila de prioridades.
//
// A fila puxa OP de quatro fontes, e uma delas é "o programador lançou no Syneco". Isso é certo
// (senão a OP fica invisível pro PCP), mas traz de volta obra antiga que ainda tem peça em aberto
// no dado — a OP-064 voltou com 2.441 peças. Não dá pra separar por status: todas estão ABERTA.
// Vitor (19/08/2026): "essas OPs pode tirar o alerta por ora, vamos deixar apenas a OP-60
// aparecendo".
//
// Dispensa é DECISÃO, não regra: fica gravada com quem dispensou e quando, e some ao ser
// desfeita. Nada é apagado da OP.
model PrioridadeTvOculta {
  id          String   @id @default(cuid())
  opNumero    String   @unique
  opId        String?
  motivo      String?
  criadoPorId String?
  createdAt   DateTime @default(now())

  @@index([opId])
}

// Pedido de expedição: o Planejamento "envia para a Expedição" as entregas
// (qtd + local) definidas por conjunto (ConjuntoEntrega). Uma por obra. A
// Expedição lê as entregas vivas agrupadas por destino, monta o romaneio,
// solicita/registra a NF e informa a transportadora. Desacoplado da OP
// (opNumero @unique + opId), como SolicitacaoProducao.
model PedidoExpedicao {
  id           String   @id @default(cuid())
  opNumero     String   @unique
  opId         String?
  status       String   @default("ENVIADO") // ENVIADO | EM_EXPEDICAO | CONCLUIDO
  enviadoPorId String?
  enviadoEm    DateTime @default(now())
  observacao   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([opNumero])
  @@index([status])
}

