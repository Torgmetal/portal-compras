generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String                @id @default(cuid())
  email                    String                @unique
  name                     String
  password                 String
  setor                    String?
  ativo                    Boolean               @default(true)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  podeAlterarVerba         Boolean               @default(false)
  tipo                     TipoUsuario
  // Troca de senha: força a definição de nova senha só no 1º acesso do
  // funcionário (senha provisória). Depois que ele troca, não volta a exigir
  // (sem expiração periódica). senhaAlteradaEm fica como registro da última troca.
  deveTrocarSenha          Boolean               @default(false)
  senhaAlteradaEm          DateTime?
  // Self-service: quando tipo=FUNCIONARIO, vincula 1:1 ao registro de RH
  funcionarioId            String?               @unique
  funcionario              Funcionario?          @relation("UsuarioFuncionario", fields: [funcionarioId], references: [id])
  lotesHoleriteCriados     LoteHolerite[]        @relation("LoteHoleriteCriadoPor")
  folhasCriadas            FolhaCompetencia[]    @relation("FolhaCriadaPor")
  pontosCriados            PontoCompetencia[]    @relation("PontoCriadaPor")
  aditivos                 Aditivo[]
  ajustesPrazoCriados      AjustePrazo[]         @relation("AjustePrazoCreatedBy")
  auditLogs                AuditLog[]
  consultasEstoqueCriadas  ConsultaEstoque[]     @relation("ConsultaEstoqueCreatedBy")
  consultaItensRespondidos ConsultaEstoqueItem[] @relation("ConsultaItemRespondidoPor")
  cronogramaRegistros      CronogramaRegistro[]  @relation("CronogramaRegistroCreatedBy")
  cronogramaRevisoes       CronogramaRevisao[]   @relation("CronogramaRevisaoCreatedBy")
  cronogramaCobrancas      CronogramaCobranca[]  @relation("CobrancaCreatedBy")
  cronogramaEnvios         CronogramaEnvio[]     @relation("CronogramaEnvioCreatedBy")
  necessidadesSemanais     NecessidadeSemanal[]  @relation("NecessidadeSemanalCreatedBy")
  notificacoes             Notificacao[]
  opsCriadas               OP[]                  @relation("OPCreatedBy")
  orcamentosCriados        Orcamento[]           @relation("OrcamentoCriadoPor")
  passwordResetTokens      PasswordResetToken[]
  prazoHistoricos          PrazoHistorico[]
  producaoDiarias          ProducaoDiaria[]      @relation("ProducaoDiariaCreatedBy")
  estudosCriados           PropostaEstudo[]      @relation("EstudoCriadoPor")
  rmsCriadas               RM[]                  @relation("RMCreatedBy")
  recebimentos             Recebimento[]
  pedidosRecebidos         PedidoOmie[]          @relation("PedidoRecebidoPor")
  revisoesCriadas          Revisao[]             @relation("RevisaoCreatedBy")
  sharepointSyncs          SharepointSync[]
  solicitacoesCriadas      SolicitacaoVerba[]    @relation("SolicitacaoCreatedBy")
  solicitacoesDecididas    SolicitacaoVerba[]    @relation("SolicitacaoDecididoBy")
  tarefasPlanejamento      TarefaPlanejamento[]  @relation("TarefaPlanejamentoCreatedBy")
  compromissos             Compromisso[]         @relation("CompromissoUser")
  compromissosCriados      Compromisso[]         @relation("CompromissoCriadoPor")
  modulos                  UserModulo[]
  pmpMetas                 PmpMeta[]             @relation("PmpMetaCriador")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  used      Boolean  @default(false)
  tentativas Int     @default(0) // nº de códigos errados tentados — trava anti-brute-force
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Meta {
  id          String   @id @default(cuid())
  modulo      String
  tipo        String
  setor       String   @default("GERAL")
  ano         Int
  mes         Int
  valorMensal Float    @default(0)
  semana1     Float?
  semana2     Float?
  semana3     Float?
  semana4     Float?
  semana5     Float?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([modulo, tipo, setor, ano, mes])
  @@index([modulo, ano])
  @@index([modulo, tipo, ano])
}

model UserModulo {
  id     String @id @default(cuid())
  userId String
  modulo Modulo
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modulo])
  @@index([userId])
}

model OP {
  id                   String               @id @default(cuid())
  numero               String               @unique
  cliente              String
  obra                 String?
  refCliente           String?              // código/nº de referência da obra no cliente (aparece nos relatórios enviados)
  descricao            String?
  status               OPStatus             @default(ABERTA)
  createdById          String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  // VÍNCULO COM O ORÇAMENTO DO COMERCIAL (SharePoint) — a OP nasce sabendo de onde veio.
  // `estudoDados` guarda o que foi LIDO da planilha (peso por área, pintura, tinta, famílias):
  // é a estimativa contra a qual o realizado vai ser comparado. Ver lib/estudo-comercial.js.
  orcamentoPasta       String? // caminho da pasta do orçamento (Comercial/1. Orçamento/...)
  orcamentoRef         String? // "249-26-DANPOWER-0328-COBERTURA"
  // Lista de propostas anexadas — quantas forem. Cada uma guarda o que a LEITURA do PDF disse que
  // ela contém (técnica, comercial, PTC, prazo, validade), em vez de a pessoa rotular na mão.
  // Vitor (19/08): "deixar anexar mais de uma proposta, assim você avalia e informa o que contém
  // em cada uma". Ver lib/proposta-comercial.js.
  propostas            Json?
  estudoArquivo        Json? // { id, nome, modelo, revisao }
  estudoDados          Json? // saída de lerEstudoComercial()
  dataFimPrevista      DateTime?
  dataFimReal          DateTime?
  dataInicio           DateTime?
  clienteCep           String?
  clienteCidade        String?
  clienteCnpj          String?
  clienteContato       String?
  clienteEmail         String?
  clienteContatos      Json                 @default("[]") // [{nome,email}] — contatos do cliente registrados nesta OP (ficam salvos ao enviar o cronograma; reaproveitados nos envios seguintes)
  clienteEndereco      String?
  clienteIE            String?
  clienteRazaoSocial   String?
  clienteTelefone      String?
  clienteUF            String?
  valorTotalContrato   Float?
  valorFaturarPorKg    Float? // R$/kg a faturar (Comercial) — base da previsão de faturamento por carga
  // Enviada pra produção pelo PCP (botão no painel de Liberar). Só as em produção aparecem nas
  // telas de Prioridades de Produção (as não enviadas somem).
  emProducao           Boolean              @default(false)
  emProducaoEm         DateTime?
  emProducaoPor        String?
  // Definidos na abertura da OP
  estoqueMaterial      String? // "PROPRIO_TORG" | "CLIENTE_TERCEIRO"
  tipoDataBook         String? // "PADRAO_TORG" | "SNQC" | "RELATORIO_ACOMPANHAMENTO"
  // ESCOPO DE QUALIDADE DA OBRA — quais relatórios esta OP exige.
  // Vitor (22/08/2026): "pode ser que em alguns casos não vamos fazer nada além de
  // certificado de qualidade e relatório de pintura; essa definição deve nascer da
  // criação da OP".
  // { preset, tipos: ["PINTURA"], definidoEm, definidoPor } — ver lib/qualidade-escopo.js.
  // É um nível ACIMA do PIT: o PIT diz o que medir DENTRO de um relatório; isto diz
  // quais relatórios existem na obra. Nulo = não definido, e aí tudo fica disponível.
  escopoQualidade      Json?
  aditivos             Aditivo[]
  ajustesPrazo         AjustePrazo[]
  cronogramas          Cronograma[]
  estoqueAlocacoes     EstoqueAlocacao[]
  estoqueReservas      EstoqueReserva[]
  fluxoCaixa           FluxoCaixa[]
  mesApontamentos      MesApontamento[]     @relation("MesApontamentosOP")
  necessidadesSemanais NecessidadeSemanal[]
  createdBy            User                 @relation("OPCreatedBy", fields: [createdById], references: [id])
  itens                OPItem[]
  medicoes             OPMedicao[]
  receitas             OPReceita[]
  orcamentos           Orcamento[]          @relation("OrcamentoOP")
  kickoff              OPKickOff?
  pecasConjunto        PecaConjunto[]
  pedidosOmieAvulsos   PedidoOmie[]
  planejamentosCarga   PlanejamentoCarga[]
  producaoSemanal      ProducaoSemanal[]
  rms                  RM[]
  rmItensDestino       RMItem[]             @relation("RMItemOpDestino")
  revisoes             Revisao[]
  romaneios            Romaneio[]
  tarefasPlanejamento  TarefaPlanejamento[]
  atasOP               AtaOP[]
  lotesExpedicao       LoteExpedicao[]
  desenhos             DesenhoOP[]
  pecasLote            PecaLote[]
  romaneiosPrevios     RomaneioPrevio[]
  pastaEngenharia      PastaEngenharia?

  @@index([numero])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdById, status])
}

model ProducaoSemanal {
  id              String   @id @default(cuid())
  semana          String
  dataInicio      DateTime
  dataFim         DateTime
  pesoPrevistoKg  Float    @default(0)
  pesoRealizadoKg Float    @default(0)
  valorPrevisto   Float    @default(0)
  valorRealizado  Float    @default(0)
  opId            String?
  observacao      String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  data            DateTime
  fonte           String?
  setor           String?
  op              OP?      @relation(fields: [opId], references: [id])

  @@unique([data, opId, setor])
  @@index([data])
  @@index([semana])
  @@index([opId])
  @@index([setor])
}

model Romaneio {
  id                String             @id @default(cuid())
  numero            String
  opId              String?
  data              DateTime
  pesoRealKg        Float
  descricao         String?
  observacao        String?
  valorPorKg        Float?
  valorTotal        Float?
  // Destino da carga (vem da entrega definida no Planejamento)
  destino           String?
  // Transportadora (campos livres no romaneio — sem cadastro)
  transportadora    String?
  motorista         String?
  placaVeiculo      String?
  contatoTransporte String?
  // Controle de NF (a própria Expedição emite/registra — controle interno)
  nfStatus          String?            @default("PENDENTE") // PENDENTE | SOLICITADA | EMITIDA
  nfNumero          String?
  nfSerie           String? // série da NF-e (vinda do Omie)
  nfChave           String? // chave de acesso (44 díg., vinda do Omie)
  nfSolicitadaEm    DateTime?
  nfEmitidaEm       DateTime?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  planejamentoCarga PlanejamentoCarga?
  op                OP?                @relation(fields: [opId], references: [id])
  itens             RomaneioItem[]

  @@index([opId])
  @@index([data])
}

model RomaneioItem {
  id             String        @id @default(cuid())
  romaneioId     String
  tipo           String
  descricao      String
  pecaConjuntoId String?
  rmItemId       String?
  qtd            Float         @default(1)
  pesoKg         Float?
  observacao     String?
  createdAt      DateTime      @default(now())
  pecaConjunto   PecaConjunto? @relation(fields: [pecaConjuntoId], references: [id])
  rmItem         RMItem?       @relation(fields: [rmItemId], references: [id])
  romaneio       Romaneio      @relation(fields: [romaneioId], references: [id], onDelete: Cascade)

  @@index([romaneioId])
  @@index([pecaConjuntoId])
  @@index([rmItemId])
}

model PlanejamentoCarga {
  id           String                       @id @default(cuid())
  opId         String
  dataPrevista DateTime
  dataOriginal DateTime? // data prevista na criação — se dataPrevista mudar, a carga fica "alterada"
  descricao    String?
  status       String                       @default("PLANEJADO")
  situacao     String                       @default("PENDENTE") // PENDENTE | CONFIRMADA | CANCELADA (previsão de faturamento)
  romaneioId   String?                      @unique
  createdById  String?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  op           OP                           @relation(fields: [opId], references: [id])
  romaneio     Romaneio?                    @relation(fields: [romaneioId], references: [id])
  itens        PlanejamentoCargaItem[]
  historico    PlanejamentoCargaHistorico[]

  @@index([opId])
  @@index([status])
  @@index([dataPrevista])
}

// Registro de mudanças de uma carga (data, quantidade por item, status).
model PlanejamentoCargaHistorico {
  id        String            @id @default(cuid())
  cargaId   String
  campo     String // "data" | "qtd" | "status" | "criacao"
  descricao String
  de        String?
  para      String?
  userId    String?
  userName  String?
  createdAt DateTime          @default(now())
  carga     PlanejamentoCarga @relation(fields: [cargaId], references: [id], onDelete: Cascade)

  @@index([cargaId])
}

model PlanejamentoCargaItem {
  id                 String            @id @default(cuid())
  planejamentoId     String
  tipo               String
  descricao          String
  pecaConjuntoId     String?
  rmItemId           String?
  qtdPlanejada       Float             @default(1)
  qtdCarregada       Float             @default(0)
  pesoEstimadoKg     Float?
  status             String            @default("PLANEJADO")
  motivoNaoEnvio     String?
  reprogramadoParaId String?
  createdAt          DateTime          @default(now())
  pecaConjunto       PecaConjunto?     @relation(fields: [pecaConjuntoId], references: [id])
  planejamento       PlanejamentoCarga @relation(fields: [planejamentoId], references: [id], onDelete: Cascade)
  rmItem             RMItem?           @relation(fields: [rmItemId], references: [id])

  @@index([planejamentoId])
  @@index([pecaConjuntoId])
  @@index([rmItemId])
  @@index([status])
}

model FluxoCaixa {
  id            String    @id @default(cuid())
  data          DateTime
  tipo          String
  categoria     String
  descricao     String
  valor         Float
  realizado     Boolean   @default(false)
  dataRealizado DateTime?
  opId          String?
  observacao    String?
  // Origem Omie (extrato de conta corrente) — importados pelo /importar-omie.
  origemOmieId  String? // ex: "EXT-<nCodCC>-<nCodLancamento>"; null = lançamento manual
  contaCorrente String? // banco/conta de origem (ex: "Inter")
  contraparte   String? // fornecedor/cliente do movimento (do extrato Omie)
  transferencia Boolean   @default(false) // transferência entre contas próprias
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  op            OP?       @relation(fields: [opId], references: [id])

  @@index([data])
  @@index([tipo])
  @@index([categoria])
  @@index([opId])
  @@index([origemOmieId])
}

model OPMedicao {
  id                String    @id @default(cuid())
  opId              String
  numeroPedidoOmie  String
  codigoPedidoOmie  String?
  descricao         String?
  data              DateTime?
  valorBruto        Float     @default(0)
  valorLiquido      Float?
  status            String?
  etapa             String?
  qtdItens          Int       @default(0)
  ultimoSync        DateTime?
  syncErro          String?
  payload           Json?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tipoDocumento     String    @default("VENDA")
  valorContratado   Float?
  valorFaturadoAuto Float?
  op                OP        @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@unique([opId, numeroPedidoOmie])
  @@index([opId])
}

model OPReceita {
  id                  String   @id @default(cuid())
  opId                String
  ordem               Int      @default(0)
  categoria           String
  descricao           String
  cfop                String?
  codigoServico       String?
  tipoPreco           String   @default("VALOR") // VALOR (fechado) | POR_UNIDADE (quantidade × valorUnitario)
  unidade             String? // unidade de medida da linha (pç, kg, t, m, m², un, cj, vb…)
  quantidade          Float? // quantidade na unidade escolhida
  valorUnitario       Float? // valor por unidade — valor = quantidade × valorUnitario
  valor               Float
  icmsPct             Float?
  ipiPct              Float?
  pisPct              Float?
  cofinsPct           Float?
  issPct              Float?
  irrfPct             Float?
  csllPct             Float?
  observacao          String?
  enderecoFaturamento String? // endereço de entrega/faturamento da linha (obra com múltiplos endereços)
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  op                  OP       @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@index([opId])
  @@index([categoria])
}

// Kick Off da OP — documento de alinhamento divulgado aos setores no início
// do contrato (1 por OP). Pré-preenchido com dados da OP/estudo; campos que
// não existem no banco (entrega, inspeção, pedido do cliente) são manuais ou
// extraídos do PDF da proposta via IA.
model OPKickOff {
  id                     String          @id @default(cuid())
  opId                   String          @unique
  // Pedido do cliente
  pedidoCompraCliente    String?
  // Entrega
  entregaEndereco        String? // endereço de ENTREGA da obra (≠ endereço fiscal)
  frete                  String? // "TORG" (CIF, por nossa conta) | "CLIENTE" (FOB)
  // Técnica
  padraoPintura          String?
  inspecao               String?
  // Fiscal
  notaRetorno            Boolean         @default(false)
  notaRetornoObs         String?
  fiscalObservacao       String? // como será o faturamento (complementa a tabela de linhas FD)
  // Conteúdo
  escopo                 String? // resumo curto do fornecimento
  escopoIncluso          String? // um item por linha (lista do que ESTÁ incluído)
  escopoExcluso          String? // um item por linha (lista do que NÃO está)
  pontosAtencao          String? // um por linha
  observacoes            String?
  // Cronograma prévio acordado com o cliente (marcos por setor/fase)
  dataEntregaAcordada    DateTime?
  cronograma             Json? // [{fase, data:"YYYY-MM-DD", obs}]
  // Prioridades de fase/peça/entrega (opcional — só obras que têm)
  prioridades            Json? // [{ordem, descricao, data:"YYYY-MM-DD"|null}]
  // Resumo de pesos da planilha comercial (sem valores em R$)
  pesoResumo             Json? // [{descricao, qtd, pesoKg}]
  // Propostas (PDF) + extração IA — comercial e técnica
  propostaPdfUrl         String? // proposta COMERCIAL
  propostaPdfNome        String?
  propostaTecnicaPdfUrl  String?
  propostaTecnicaPdfNome String?
  extraidoIA             Json?
  // Anexos técnicos: PLP (plano de pintura) e documento de inspeção (ITP)
  pinturaPlpUrl          String?
  pinturaPlpNome         String?
  inspecaoArquivoUrl     String?
  inspecaoArquivoNome    String?
  // Fiscal estruturado
  tipoFaturamento        String? // como definido na proposta (medições, eventos, à vista...)
  faturamentoEventos     Json? // [{descricao, percentual, valor, prazoPagamento, medicao, obsNF}]
  retencaoContratual     String? // ex: "5% — liberação após CND"
  segurosObrigatorios    String?
  aceites                KickoffAceite[]
  // Reuniões e divulgação
  kickoffComercialEm     DateTime?
  kickoffSetoresEm       DateTime?
  enviadoPara            String?
  enviadoEm              DateTime?
  createdById            String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  op                     OP              @relation(fields: [opId], references: [id], onDelete: Cascade)
}

// Aceite dos setores ao Kick Off divulgado — cada destinatário recebe um link
// único por e-mail e confirma que está de acordo com as informações.
model KickoffAceite {
  id        String    @id @default(cuid())
  kickoffId String
  tipo      String    @default("GERAL") // GERAL | FISCAL
  email     String
  token     String    @unique
  enviadoEm DateTime  @default(now())
  aceitoEm  DateTime?
  aceitoIp  String?   // IP de quem confirmou — o aceite vai impresso no PDF, tem de ser provável
  cobradoEm DateTime? // última cobrança do aceite pendente (reenvio) — `enviadoEm` fica com o 1º envio
  cobrancas Int       @default(0)
  kickoff   OPKickOff @relation(fields: [kickoffId], references: [id], onDelete: Cascade)

  @@index([kickoffId])
}

// Ata de reunião POR OP (comercial → aba Planejamento). Distinta das atas SEMANAIS
// (AtaReuniao). Numeração sequencial por OP; rascunho preenchido por IA; enviada
// ao cliente por token pra aceite. Criada via SQL no Neon (não db push).
model AtaOP {
  id            String    @id @default(cuid())
  opId          String
  opNumero      String
  numero        Int // sequencial por OP (ATA OP-102 #01)
  titulo        String
  dataReuniao   DateTime?
  participantes String?
  pauta         String? // conteúdo da ata (texto, preenchido/ajustado pela IA)
  conteudoJson  Json? // estrutura da ata da IA: { resumo, topicos[], acoes[] }
  anexos        Json      @default("[]") // [{ seq, nome, url, tamanho }]
  status        String    @default("RASCUNHO") // RASCUNHO | ENVIADA | ACEITA
  tokenCliente  String?   @unique
  clienteNome   String?
  clienteEmail  String?
  enviadoEm     DateTime?
  pdfEnviadoUrl String? // cópia EXATA do PDF anexado no envio (o que o cliente recebeu)
  pdfEnviadoEm  DateTime?
  aceiteEm      DateTime?
  aceiteNome    String?
  aceiteIp      String?
  criadoPorId   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  op            OP        @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@unique([opId, numero])
  @@index([opId])
}

// Lote de entrega da OP (Expedição). Importado de planilha ou manual. No início
// costuma vir SEM peso (só prioridade/local); a Engenharia refina a lista final
// e aí entram os pesos. status = PENDENTE | ENTREGUE (baixa por romaneio, futuro).
model LoteExpedicao {
  id           String    @id @default(cuid())
  opId         String
  ordem        Int       @default(0) // prioridade de entrega (menor = primeiro)
  nome         String
  local        String? // local de entrega (pode variar por lote)
  dataPrevista DateTime?
  pesoKg       Float? // definido depois, pela lista final da Engenharia
  observacao   String?
  transportadora    String? // dados do transportador (salvos aqui pra não redigitar no romaneio)
  motorista         String?
  placaVeiculo      String? // placa do caminhão/cavalo
  placaCarreta      String? // placa da carreta (quando é carreta, tem 2 placas)
  contatoTransporte String?
  status       String    @default("PENDENTE")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  op           OP               @relation(fields: [opId], references: [id], onDelete: Cascade)
  desenhos     DesenhoOP[]
  pecas        PecaLote[]
  romaneios    RomaneioPrevio[]

  @@index([opId])
}

// Peça registrada num lote de entrega — vem da LISTA DO TEKLA subida no
// Planejamento. É daqui que sai o PESO FINAL do lote (soma de pesoTotalKg).
model PecaLote {
  id          String         @id @default(cuid())
  opId        String
  loteId      String?
  marca       String
  descricao   String?
  qtd         Float?
  pesoUnitKg  Float?
  pesoTotalKg Float?
  createdAt   DateTime       @default(now())
  op          OP             @relation(fields: [opId], references: [id], onDelete: Cascade)
  lote        LoteExpedicao? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([opId])
  @@index([loteId])
}

// Desenho/projeto da OP na aba Engenharia. UPLOAD (arquivo no Blob) ou SHAREPOINT
// (referência a um item na pasta da obra, servido por proxy). DWG ou PDF.
model DesenhoOP {
  id        String   @id @default(cuid())
  opId      String
  ordem     Int      @default(0)
  nome      String
  ext       String? // pdf | dwg | ...
  origem    String   @default("UPLOAD") // UPLOAD | SHAREPOINT
  url       String? // Blob (UPLOAD)
  driveId   String? // SHAREPOINT
  itemId    String? // SHAREPOINT
  webUrl    String? // link na fonte (SHAREPOINT)
  area      String? // Montagem | Conjunto (SHAREPOINT)
  tamanho   Int?
  loteId    String? // lote de entrega de que este desenho faz parte
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  op        OP             @relation(fields: [opId], references: [id], onDelete: Cascade)
  lote      LoteExpedicao? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([opId])
  @@index([loteId])
}

model OPItem {
  id                String             @id @default(cuid())
  opId              String
  ordem             Int                @default(0)
  descricao         String
  codigoOmie        String?
  unidade           String?
  qtdContratada     Float?
  valorVerba        Float
  faturamentoDireto Boolean            @default(false)
  observacao        String?
  capacidade        String?
  categoria         String
  meses             Int?
  tipo              ItemTipo           @default(VERBA)
  valorPorMes       Float?
  cmcMedio          Float?
  localEstoque      String?
  op                OP                 @relation(fields: [opId], references: [id], onDelete: Cascade)
  rmItens           RMItem[]
  solicitacoesVerba SolicitacaoVerba[]

  @@index([opId])
  @@index([categoria])
}

model Revisao {
  id          String   @id @default(cuid())
  opId        String
  numero      Int
  motivo      String
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation("RevisaoCreatedBy", fields: [createdById], references: [id])
  op          OP       @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@unique([opId, numero])
  @@index([opId])
}

model Aditivo {
  id          String        @id @default(cuid())
  opId        String
  numero      Int
  descricao   String
  // Aditivo tem prazo PRÓPRIO e vínculo PRÓPRIO com o orçamento — ele nasce de outra proposta e
  // de outro estudo, e a informação precisa chegar a todos os setores.
  // Vitor (19/08): "quando criamos um aditivo precisa ser divulgado a todos os setores… teria que
  // ter a mesma coisa, importar proposta e planilha de estudo… importante ter data de início e fim".
  dataInicio       DateTime?
  dataFimPrevista  DateTime?
  orcamentoPasta   String?
  orcamentoRef     String?
  propostas        Json?
  estudoArquivo    Json?
  estudoDados      Json?
  createdById String
  createdAt   DateTime      @default(now())
  createdBy   User          @relation(fields: [createdById], references: [id])
  op          OP            @relation(fields: [opId], references: [id], onDelete: Cascade)
  itens       AditivoItem[]

  @@unique([opId, numero])
  @@index([opId])
}

model AditivoItem {
  id                String             @id @default(cuid())
  aditivoId         String
  ordem             Int                @default(0)
  descricao         String
  codigoOmie        String?
  unidade           String?
  qtdContratada     Float?
  valorVerba        Float
  faturamentoDireto Boolean            @default(false)
  observacao        String?
  capacidade        String?
  categoria         String
  meses             Int?
  tipo              ItemTipo           @default(VERBA)
  valorPorMes       Float?
  cmcMedio          Float?
  localEstoque      String?
  aditivo           Aditivo            @relation(fields: [aditivoId], references: [id], onDelete: Cascade)
  rmItens           RMItem[]
  solicitacoesVerba SolicitacaoVerba[]

  @@index([aditivoId])
  @@index([categoria])
}

model AjustePrazo {
  id              String   @id @default(cuid())
  opId            String
  dataFimAnterior DateTime
  dataFimNova     DateTime
  motivo          String
  createdById     String
  createdAt       DateTime @default(now())
  createdBy       User     @relation("AjustePrazoCreatedBy", fields: [createdById], references: [id])
  op              OP       @relation(fields: [opId], references: [id], onDelete: Cascade)

  @@index([opId])
}

model SolicitacaoVerba {
  id               String                 @id @default(cuid())
  opItemId         String?
  aditivoItemId    String?
  valorAtual       Float
  valorProposto    Float
  justificativa    String
  status           SolicitacaoVerbaStatus @default(PENDENTE)
  observacaoMaster String?
  decididoEm       DateTime?
  decididoById     String?
  createdById      String
  createdAt        DateTime               @default(now())
  aditivoItem      AditivoItem?           @relation(fields: [aditivoItemId], references: [id], onDelete: Cascade)
  createdBy        User                   @relation("SolicitacaoCreatedBy", fields: [createdById], references: [id])
  decididoBy       User?                  @relation("SolicitacaoDecididoBy", fields: [decididoById], references: [id])
  opItem           OPItem?                @relation(fields: [opItemId], references: [id], onDelete: Cascade)

  @@index([opItemId])
  @@index([aditivoItemId])
  @@index([status])
}

model RM {
  id                 String            @id @default(cuid())
  numero             String            @unique
  opId               String?
  tipo               String            @default("Material")
  descricao          String
  observacao         String?
  status             RMStatus          @default(ABERTA)
  categoriaCompra    String?
  localEstoque       String?
  createdById        String
  setor              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  categoriasOP       String[]          @default([])
  tipoRM             TipoRM            @default(ENGENHARIA)
  faturamentoDireto  Boolean           @default(false)
  anexos             Anexo[]
  consultasEstoque   ConsultaEstoque[]
  cotacoes           Cotacao[]
  envios             Envio[]
  pedidosFDAtendidos PedidoOmie[]      @relation("PedidoOmieRMAtendida")
  createdBy          User              @relation("RMCreatedBy", fields: [createdById], references: [id])
  op                 OP?               @relation(fields: [opId], references: [id])
  itens              RMItem[]

  @@index([opId])
  @@index([status])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([opId, status])
}

model PedidoOmie {
  id                   String           @id @default(cuid())
  cotacaoId            String?
  fornecedorNome       String
  nCodFor              String?
  cnpj                 String?
  codigoPedido         String?
  numeroPedido         String?
  total                Float            @default(0)
  faturamentoDireto    Boolean          @default(false)
  status               String           @default("CRIADO")
  observacao           String?
  erroOmie             String?
  payload              Json?
  resposta             Json?
  createdById          String?
  createdAt            DateTime         @default(now())
  anexoNome            String?
  anexoUrl             String?
  criadoManualmente    Boolean          @default(false)
  opId                 String?
  categoriaItem        String?
  itensDetalhes        Json?
  rmAtendidaId         String?
  dataEntregaReal      DateTime?
  prazoEntregaPrevisto DateTime?
  statusEntrega        String?
  prazoOriginal        DateTime?
  tokenEntrega         String?          @unique
  itensOmie            Json?
  nfNumero             String?
  nfSerie              String?
  nfChave              String?
  recebidoPorId        String?
  recebidoEm           DateTime?
  syncEntregaEm        DateTime? // última verificação de entrega no Omie (rotação do cron sync-entregas)
  recebidoPor          User?            @relation("PedidoRecebidoPor", fields: [recebidoPorId], references: [id])
  cotacao              Cotacao?         @relation(fields: [cotacaoId], references: [id])
  op                   OP?              @relation(fields: [opId], references: [id])
  rmAtendida           RM?              @relation("PedidoOmieRMAtendida", fields: [rmAtendidaId], references: [id])
  prazoHistorico       PrazoHistorico[]
  rmItens              RMItem[]
  recebimentos         Recebimento[]

  @@index([cotacaoId])
  @@index([opId])
  @@index([status])
  @@index([dataEntregaReal, syncEntregaEm])
}

model PrazoHistorico {
  id            String     @id @default(cuid())
  pedidoId      String
  prazoAnterior DateTime?
  prazoNovo     DateTime
  motivo        String?
  alteradoPorId String?
  criadoEm      DateTime   @default(now())
  alteradoPor   User?      @relation(fields: [alteradoPorId], references: [id])
  pedido        PedidoOmie @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
}

model RMItem {
  id                     String                  @id @default(cuid())
  rmId                   String
  opItemId               String?
  ordem                  Int                     @default(0)
  descricao              String
  unidade                String
  qtd                    Float
  material               String?
  comprimento            String?
  largura                String?
  peso                   Float?
  pesoLinear             Float?
  codigo                 String?
  tratamento             String?
  observacao             String?
  aditivoItemId          String?
  canceladoEm            DateTime?
  canceladoMotivo        String?
  atendidoEstoqueEm      DateTime?
  atendidoEstoqueQtd     Float?
  atendidoEstoqueObs     String?
  atendidoEstoquePreco   Float?
  atendidoEstoqueTotal   Float?
  status                 RMItemStatus            @default(PENDENTE)
  pedidoOmieId           String?
  codigoOmieEstoque      String?
  destinoEstoque         Boolean                 @default(false)
  opDestinoId            String?
  valorDiaria            Float?
  qtdDias                Int?
  valorTotal             Float?
  consultaEstoqueItens   ConsultaEstoqueItem[]
  cotacaoItens           CotacaoItem[]
  planejamentoCargaItens PlanejamentoCargaItem[]
  aditivoItem            AditivoItem?            @relation(fields: [aditivoItemId], references: [id])
  opDestino              OP?                     @relation("RMItemOpDestino", fields: [opDestinoId], references: [id])
  opItem                 OPItem?                 @relation(fields: [opItemId], references: [id])
  pedidoOmie             PedidoOmie?             @relation(fields: [pedidoOmieId], references: [id])
  rm                     RM                      @relation(fields: [rmId], references: [id], onDelete: Cascade)
  recebimentos           Recebimento[]
  romaneioItens          RomaneioItem[]

  @@index([rmId])
  @@index([opItemId])
  @@index([aditivoItemId])
  @@index([status])
  @@index([pedidoOmieId])
  @@index([status, opDestinoId])
  @@index([rmId, status])
}

model Cotacao {
  id                     String        @id @default(cuid())
  rmId                   String
  fornecedorNome         String
  fornecedorEmail        String?
  nCodOmie               String?
  cnpj                   String?
  faturamento            String        @default("Torg")
  prazoPagamento         String?
  observacao             String?
  total                  Float         @default(0)
  prazoResposta          DateTime?
  recebidaEm             DateTime?
  declinadaEm            DateTime?
  motivoDeclinio         String?
  status                 CotacaoStatus @default(PENDENTE)
  token                  String?       @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  numeroRevisao          Int           @default(0)
  totalProposta          Float?
  solicitadaRevisaoFinal DateTime?
  fornecedorId           String?
  numeroProposta         String?
  anexos                 Anexo[]
  fornecedor             Fornecedor?   @relation(fields: [fornecedorId], references: [id])
  rm                     RM            @relation(fields: [rmId], references: [id], onDelete: Cascade)
  itens                  CotacaoItem[]
  pedidosOmie            PedidoOmie[]

  @@index([rmId])
  @@index([fornecedorId])
  @@index([status])
  @@index([token])
  @@index([status, createdAt])
  @@index([rmId, status])
}

model CotacaoItem {
  id                String    @id @default(cuid())
  cotacaoId         String
  rmItemId          String
  precoUnit         Float
  qtdCotada         Float
  qtdProposta       Float?
  // Abatimento por estoque (consulta respondida pela Produção/Engenharia em barras):
  // qtdPecasCotada = nº de barras/peças LÍQUIDO enviado ao fornecedor;
  // estoqueAbatidoQtd = nº de barras/peças abatidas do estoque. Null = sem abatimento.
  qtdPecasCotada    Float?
  estoqueAbatidoQtd Float?
  icmsPct           Float?
  ipiPct            Float?
  observacao        String?
  vencedor          Boolean   @default(false)
  prazoEntrega      DateTime?
  // ⚠ ENTREGA É POR ITEM, NÃO POR PEDIDO. A cotação tem em média 9,6 itens; marcar uma linha como
  // entregue fechava o pedido inteiro e dava baixa nas outras 8,6 sem ninguém conferir. O pedido
  // só fecha quando TODOS os itens tiverem esta data.
  entregaRealEm     DateTime?
  semEstoque        Boolean   @default(false)
  cotacao           Cotacao   @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  rmItem            RMItem    @relation(fields: [rmItemId], references: [id])

  @@index([cotacaoId])
  @@index([rmItemId])
  @@index([cotacaoId, vencedor])
  @@index([rmItemId, vencedor])
}

model Envio {
  id              String   @id @default(cuid())
  rmId            String
  fornecedorNome  String
  fornecedorEmail String
  data            DateTime @default(now())
  status          String   @default("Enviado")
  rm              RM       @relation(fields: [rmId], references: [id], onDelete: Cascade)

  @@index([rmId])
}

model Anexo {
  id          String   @id @default(cuid())
  cotacaoId   String?
  rmId        String?
  nomeArquivo String
  blobUrl     String
  tamanho     Int
  tipo        String
  uploadedAt  DateTime @default(now())
  cotacao     Cotacao? @relation(fields: [cotacaoId], references: [id], onDelete: Cascade)
  rm          RM?      @relation(fields: [rmId], references: [id], onDelete: Cascade)

  @@index([cotacaoId])
  @@index([rmId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Fornecedor {
  id               String    @id @default(cuid())
  razaoSocial      String
  nomeFantasia     String?
  cnpj             String?
  // Opcional: fornecedores importados do Omie geralmente não têm e-mail lá; ficam
  // marcados "falta e-mail" e o time completa antes de cotar. Cadastro manual continua exigindo.
  email            String?
  emailsAdicionais String[]
  telefone         String?
  contato          String?
  cidade           String?
  uf               String?
  categorias       String[]
  observacao       String?
  nCodOmie         String?
  // Sincronização com o cadastro de fornecedores do Omie (geral/clientes, tag "Fornecedor").
  omieSyncEm       DateTime?
  ativo            Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  cotacoes         Cotacao[]

  @@index([ativo])
  @@index([nCodOmie])
}

// Fornecedores do Omie que foram EXCLUÍDOS manualmente da Vendor List — o `nCodOmie`
// fica bloqueado pra não voltar numa próxima sincronização com o Omie.
model FornecedorOmieBloqueado {
  id          String   @id @default(cuid())
  nCodOmie    String   @unique
  razaoSocial String?
  motivo      String?
  createdById String?
  createdAt   DateTime @default(now())
}

model EmailNotificacao {
  id        String   @id @default(cuid())
  email     String
  nome      String?
  eventos   String[]
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ativo])
}

model CategoriaFornecedor {
  id        String   @id @default(cuid())
  codigo    String   @unique
  label     String
  color     String   @default("slate")
  ordem     Int      @default(100)
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notificacao {
  id           String          @id @default(cuid())
  tipo         NotificacaoTipo
  titulo       String
  mensagem     String
  link         String?
  dados        Json?
  origemUserId String?
  lida         Boolean         @default(false)
  lidaEm       DateTime?
  createdAt    DateTime        @default(now())
  origemUser   User?           @relation(fields: [origemUserId], references: [id])

  @@index([lida])
  @@index([createdAt])
  @@index([tipo])
}

model ConsultaEstoque {
  id           String                @id @default(cuid())
  rmId         String
  status       String                @default("ENVIADA")
  mensagem     String?
  createdById  String
  respondidoEm DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  createdBy    User                  @relation("ConsultaEstoqueCreatedBy", fields: [createdById], references: [id])
  rm           RM                    @relation(fields: [rmId], references: [id], onDelete: Cascade)
  itens        ConsultaEstoqueItem[]

  @@index([rmId])
  @@index([status])
}

model ConsultaEstoqueItem {
  id              String          @id @default(cuid())
  consultaId      String
  rmItemId        String
  resposta        String?
  qtdDisponivel   Float?
  observacao      String?
  respondidoPorId String?
  respondidoEm    DateTime?
  consulta        ConsultaEstoque @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  respondidoPor   User?           @relation("ConsultaItemRespondidoPor", fields: [respondidoPorId], references: [id])
  rmItem          RMItem          @relation(fields: [rmItemId], references: [id])

  @@unique([consultaId, rmItemId])
  @@index([rmItemId])
}

model Setor {
  id           String        @id @default(cuid())
  nome         String        @unique
  sigla        String?
  cor          String?
  gestorId     String?
  ativo        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  funcionarios Funcionario[] @relation("FuncionarioSetor")
  gestor       Funcionario?  @relation("GestorSetor", fields: [gestorId], references: [id])
  vagas        Vaga[]
}

model Cargo {
  id           String             @id @default(cuid())
  nome         String
  nivel        String?
  categoria    String?
  salarioBase  Float?
  cbo          String?
  ativo        Boolean            @default(true)
  // Matriz de Competências (FORM-11 / ISO 9001 §7.2)
  descricao    String? // descrição da função
  area         String? // área / setor da função
  matriz       Json? // metadados FORM-11: { revisao, revisadaEm, escolaridadeObrigatoria, escolaridadeDesejavel, experienciaAdmissao, experienciaPromocao, qualificacoes:[{grupo,item,evidencia}], emitidoPor, aprovadoPor }
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  competencias CargoCompetencia[]
  funcionarios Funcionario[]
  vagas        Vaga[]

  @@index([nivel])
  @@index([categoria])
}

model Funcionario {
  id                    String                    @id @default(cuid())
  nome                  String
  cpf                   String?                   @unique
  pis                   String? // PIS/PASEP — usado p/ casar marcações do ACJEF (ponto)
  empresa               String? // empresa empregadora (TORG Metal / VMI) — holerite/ponto multi-CNPJ
  centroCusto           String? // classificação de custo: MOD, MOI, DP, TST, TERCEIRO...
  banco                 String? // dados bancários (cadastro completo)
  agencia               String?
  conta                 String?
  pixChave              String?
  rg                    String?
  dataNascimento        DateTime?
  email                 String?
  telefone              String?
  endereco              String?
  cidadeUF              String?
  matricula             String?                   @unique
  dataAdmissao          DateTime
  dataDemissao          DateTime?
  setorId               String
  cargoId               String
  salario               Float?
  tipoContrato          String                    @default("CLT")
  jornadaHoras          Int                       @default(44)
  turno                 String?
  status                String                    @default("ATIVO")
  ativo                 Boolean                   @default(true)
  foto                  String?
  observacao            String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  categoriaDesligamento String?
  motivoDesligamento    String?
  tipoDesligamento      String?
  afastamentos          Afastamento[]
  dependentes           Dependente[]
  documentos            Documento[]
  ferias                Ferias[]
  holerites             Holerite[]
  folhaItens            FolhaItem[]
  pontoItens            PontoItem[]
  usuario               User?                     @relation("UsuarioFuncionario")
  cargo                 Cargo                     @relation(fields: [cargoId], references: [id])
  setor                 Setor                     @relation("FuncionarioSetor", fields: [setorId], references: [id])
  beneficios            FuncionarioBeneficio[]
  competencias          FuncionarioCompetencia[]
  pontos                Ponto[]
  setoresGeridos        Setor[]                   @relation("GestorSetor")
  treinamentos          TreinamentoParticipante[]

  @@index([setorId])
  @@index([cargoId])
  @@index([status])
  @@index([ativo])
  @@index([dataDemissao])
}

model Dependente {
  id             String      @id @default(cuid())
  funcionarioId  String
  nome           String
  parentesco     String
  dataNascimento DateTime?
  cpf            String?
  createdAt      DateTime    @default(now())
  funcionario    Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
}

model Ponto {
  id               String      @id @default(cuid())
  funcionarioId    String
  data             DateTime    @db.Date
  entrada1         String?
  saida1           String?
  entrada2         String?
  saida2           String?
  horasTrabalhadas Float?
  horasExtras      Float       @default(0)
  bancoHoras       Float       @default(0)
  tipo             String      @default("NORMAL")
  observacao       String?
  createdAt        DateTime    @default(now())
  funcionario      Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, data])
  @@index([data])
}

model Ferias {
  id                 String      @id @default(cuid())
  funcionarioId      String
  periodoAquisInicio DateTime
  periodoAquisFim    DateTime
  dataInicio         DateTime?
  dataFim            DateTime?
  diasGozo           Int?
  diasVendidos       Int         @default(0)
  valorEstimado      Float? // valor líquido estimado (bruto − descontos) — snapshot
  descontos          Float       @default(0) // descontos manuais (empréstimos etc.)
  periodoIndice      Int? // nº do período aquisitivo (0 = 1º ano) inferido da dataInicio vs. admissão. Lançar uma férias retroativa avança o período: as anteriores contam como gozadas.
  status             String      @default("PENDENTE")
  observacao         String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  funcionario        Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([status])
}

model Beneficio {
  id           String                 @id @default(cuid())
  nome         String                 @unique
  tipo         String
  valorPadrao  Float?
  ativo        Boolean                @default(true)
  createdAt    DateTime               @default(now())
  funcionarios FuncionarioBeneficio[]
}

model FuncionarioBeneficio {
  id            String      @id @default(cuid())
  funcionarioId String
  beneficioId   String
  valorMensal   Float
  ativo         Boolean     @default(true)
  dataInicio    DateTime    @default(now())
  dataFim       DateTime?
  beneficio     Beneficio   @relation(fields: [beneficioId], references: [id])
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, beneficioId])
}

model Competencia {
  id           String                   @id @default(cuid())
  nome         String                   @unique
  categoria    String?
  descricao    String?
  createdAt    DateTime                 @default(now())
  cargos       CargoCompetencia[]
  funcionarios FuncionarioCompetencia[]
}

model CargoCompetencia {
  id            String      @id @default(cuid())
  cargoId       String
  competenciaId String
  nivelEsperado Int         @default(3)
  cargo         Cargo       @relation(fields: [cargoId], references: [id], onDelete: Cascade)
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)

  @@unique([cargoId, competenciaId])
}

model FuncionarioCompetencia {
  id            String      @id @default(cuid())
  funcionarioId String
  competenciaId String
  nivelAtual    Int         @default(1)
  avaliadoEm    DateTime?
  avaliadoPor   String?
  competencia   Competencia @relation(fields: [competenciaId], references: [id], onDelete: Cascade)
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, competenciaId])
}

model Documento {
  id               String       @id @default(cuid())
  nome             String
  tipo             String
  categoria        String
  descricao        String?
  funcionarioId    String?
  dataEmissao      DateTime?
  dataValidade     DateTime?
  orgaoEmissor     String?
  numeroDocumento  String?
  observacao       String?
  ativo            Boolean      @default(true)
  // Arquivo anexado (Vercel Blob) + cópia de backup no SharePoint (controle ISO)
  arquivoUrl       String? // URL do Blob (privada: só servida via proxy autenticado)
  arquivoNome      String?
  arquivoTamanho   Int?
  arquivoTipo      String?
  sharepointUrl    String? // webUrl da cópia no SharePoint (backup ISO)
  // Quando setado, o arquivo é servido direto do SharePoint (sem cópia no Blob) —
  // usado pela importação em massa dos documentos de RH já existentes no SP.
  sharepointItemId String?      @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  funcionario      Funcionario? @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@index([funcionarioId])
  @@index([categoria])
  @@index([dataValidade])
  @@index([tipo])
}

// Lote de importação de holerites — um PDF multipágina (1 holerite/página) que a
// contabilidade envia por competência. Mantém o arquivo original e rastreia o split.
model LoteHolerite {
  id                  String     @id @default(cuid())
  competencia         String // "AAAA-MM" (ex: "2026-05")
  empresa             String? // razão social predominante (TORG Metal, VMI...)
  cnpj                String?
  arquivoOriginalUrl  String? // Blob privado do PDF completo enviado
  arquivoOriginalNome String?
  totalPaginas        Int        @default(0)
  criadoPorId         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  criadoPor           User?      @relation("LoteHoleriteCriadoPor", fields: [criadoPorId], references: [id])
  holerites           Holerite[]

  @@index([competencia])
}

// Holerite individual de um funcionário numa competência. Arquivo (página única)
// no Blob privado, servido via proxy autenticado (mesmo padrão de Documento).
model Holerite {
  id             String        @id @default(cuid())
  funcionarioId  String
  loteId         String?
  competencia    String // "AAAA-MM"
  empresa        String?
  tipo           String        @default("MENSAL") // MENSAL | DECIMO_TERCEIRO | FERIAS | RESCISAO
  valorLiquido   Float? // parse best-effort do PDF
  arquivoUrl     String? // Blob do PDF (página individual OU o PDF completo do lote)
  arquivoNome    String?
  arquivoTamanho Int?
  pagina         Int? // quando arquivoUrl é o PDF completo, a página deste holerite (1-based)
  status         String        @default("PENDENTE") // PENDENTE | ENVIADO | VISUALIZADO | CONFIRMADO
  enviadoEm      DateTime?
  visualizadoEm  DateTime?
  confirmadoEm   DateTime?
  confirmadoIp   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  funcionario    Funcionario   @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  lote           LoteHolerite? @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@unique([funcionarioId, competencia, tipo])
  @@index([competencia])
  @@index([status])
  @@index([funcionarioId])
}

// Folha de Pagamento — substitui a planilha de fechamento. Uma FolhaCompetencia
// por mês (AAAA-MM); cada FolhaItem é um funcionário com snapshot do cadastro +
// os valores digitados pelo RH. Os derivados (Base INSS, FGTS, INSS Patronal...)
// são calculados em lib/folha-calc.js (não persistidos — fonte única de cálculo).
model FolhaCompetencia {
  id          String      @id @default(cuid())
  competencia String      @unique // "AAAA-MM"
  status      String      @default("ABERTA") // ABERTA | FECHADA
  criadoPorId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  criadoPor   User?       @relation("FolhaCriadaPor", fields: [criadoPorId], references: [id])
  itens       FolhaItem[]

  @@index([competencia])
}

model FolhaItem {
  id            String           @id @default(cuid())
  folhaId       String
  funcionarioId String?
  // Snapshot do cadastro no momento da competência (cadastro muda mês a mês)
  nome          String
  cpf           String?
  empresa       String?
  centroCusto   String?
  tipoContrato  String           @default("CLT") // CLT | PJ
  salarioBase   Float            @default(0)
  // Horas do Controle de Ponto (RH ajusta) — o portal calcula o R$ (valor-hora × %).
  heHoras50     Float            @default(0)
  heHoras60     Float            @default(0)
  heHoras80     Float            @default(0)
  heHoras100    Float            @default(0)
  heHoras150    Float            @default(0)
  faltasHoras   Float            @default(0)
  atrasosHoras  Float            @default(0)
  adNoturnoHoras Float           @default(0) // horas noturnas (Ponto) — portal calcula 20%
  divisorHoras  Float            @default(220) // divisor do valor-hora (jornada×5; 44h→220)
  // Digitados pelo RH (vêm do sistema de folha)
  horasExtras   Float            @default(0) // LEGADO: HE em R$ (competências antigas)
  adicionais    Float            @default(0)
  descontos     Float            @default(0)
  inss          Float            @default(0)
  irrf          Float            @default(0)
  liquido       Float            @default(0)
  vr            Float            @default(0)
  ifood         Float            @default(0)
  kr            Float            @default(0)
  rescisao      Float            @default(0)
  observacao    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  folha         FolhaCompetencia @relation(fields: [folhaId], references: [id], onDelete: Cascade)
  funcionario   Funcionario?     @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)

  @@unique([folhaId, funcionarioId])
  @@index([folhaId])
  @@index([empresa])
  @@index([centroCusto])
}

// Controle de Ponto — importa o arquivo ACJEF (Portaria 1510) por competência.
// PontoItem = um funcionário no mês, com as marcações importadas (Json, referência)
// e os totais que o RH confere/preenche pra contabilidade.
model PontoCompetencia {
  id          String      @id @default(cuid())
  competencia String      @unique // "AAAA-MM"
  empresa     String?
  status      String      @default("ABERTA") // ABERTA | FECHADA
  criadoPorId String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  criadoPor   User?       @relation("PontoCriadaPor", fields: [criadoPorId], references: [id])
  itens       PontoItem[]

  @@index([competencia])
}

model PontoItem {
  id               String           @id @default(cuid())
  pontoId          String
  funcionarioId    String?
  pisArquivo       String // chave do arquivo: PIS (ACJEF) ou CPF-dígitos (PDF Secullum)
  cpfArquivo       String? // CPF como veio no PDF Secullum (dígitos) — casa com o cadastro
  empresa          String? // empresa do arquivo (TORG/VMI) — multi-empresa por competência
  nome             String? // preenchido quando casa/mapeia o funcionário
  marcacoes        Json? // [{ data, marcacoes[], raw }] — referência (ACJEF)
  diario           Json? // espelho diário do PDF Secullum: { totais{min}, dias[{data,batidas,faixas}] }
  pdfUrl           String? // Blob do PDF Secullum COMPLETO (a página do funcionário é extraída sob demanda)
  pagina           Int? // nº da página deste funcionário dentro do PDF completo (1-based)
  origem           String          @default("MANUAL") // MANUAL | ACJEF | SECULLUM_PDF
  horasNormais     Float            @default(0)
  horasExtras50    Float            @default(0)
  horasExtras60    Float            @default(0)
  horasExtras80    Float            @default(0)
  horasExtras100   Float            @default(0)
  horasExtras150   Float            @default(0)
  faltas           Float            @default(0)
  atrasos          Float            @default(0)
  adicionalNoturno Float            @default(0)
  dsr              Float            @default(0)
  ajudaCusto       Float            @default(0)
  observacao       String?
  status           String           @default("PENDENTE") // PENDENTE | VISUALIZADO | CONFIRMADO (ciência do colaborador)
  visualizadoEm    DateTime?
  confirmadoEm     DateTime?
  confirmadoIp     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  ponto            PontoCompetencia @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  funcionario      Funcionario?     @relation(fields: [funcionarioId], references: [id], onDelete: SetNull)

  @@unique([pontoId, pisArquivo])
  @@index([pontoId])
  @@index([funcionarioId])
}

// Mural do portal do funcionário: comunicados/avisos que o RH publica para todos
// (opcionalmente disparados por e-mail). Sem relações — nomes denormalizados.
model MuralAviso {
  id                 String    @id @default(cuid())
  titulo             String
  corpo              String
  imagemUrl          String? // imagem opcional do comunicado (Vercel Blob público)
  fixado             Boolean   @default(false)
  emailEnviadoEm     DateTime?
  emailDestinatarios Int?
  criadoPorId        String?
  criadoPorNome      String?
  ativo              Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ativo, createdAt])
}

// Sugestões/feedback que o funcionário envia para o RH (portal /meu-rh).
model FeedbackRH {
  id              String    @id @default(cuid())
  funcionarioId   String?
  funcionarioNome String?
  anonimo         Boolean   @default(false)
  categoria       String? // SUGESTAO | RECLAMACAO | ELOGIO | DUVIDA | OUTRO
  mensagem        String
  status          String    @default("NOVO") // NOVO | LIDO | RESOLVIDO
  lidoEm          DateTime?
  createdAt       DateTime  @default(now())

  @@index([status, createdAt])
}

// Painel de Relatórios — v1: relatório de status com fotos p/ o cliente, no
// layout padrão Torg (linha do Data Book). blocos = JSON [{ id, titulo,
// descricao, fotos: [{ url, legenda }] }]. Sem relações — vínculo à OP é só snapshot.
model RelatorioStatus {
  id            String   @id @default(cuid())
  numero        Int? // sequencial global (REL-001) — atribuído na criação
  opId          String?
  opNumero      String? // OP.numero é texto ("067", "T60B") — snapshot
  cliente       String?
  obra          String?
  titulo        String
  resumo        String?
  blocos        Json     @default("[]")
  status        String   @default("RASCUNHO") // RASCUNHO | EMITIDO
  token         String?  @unique // link público de aceite do cliente
  aceitoEm      DateTime?
  aceitoNome    String?
  aceitoIp      String?
  envios        Json     @default("[]") // histórico: [{ para, cc, porNome, em }]
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
  @@index([opId])
}

// Orçamento de Serviço (Comercial → Central de Orçamentos) — separado do
// Orcamento de estrutura. servicos = JSON de chaves (CORTE_FURACAO, JATEAMENTO,
// PINTURA, SOLDA). Criado por SQL; abas da proposta virão depois.
// ─── ESTUDO DE FABRICACAO (a LQC dentro do portal) ────────────────────────────
// Vitor (22/08/2026): "que voce transforme cada aba da geracao de custo igual esta na nossa LQC, e
// quando eu pedir para extrair uma planilha voce iria trazer exatamente o mesmo modelo preenchido".
//
// ⚠ NAO E O ORCAMENTO DE SERVICO. Sao produtos diferentes: o de servico vende hora/kg de corte,
// jato, pintura e solda no material do CLIENTE; este vende estrutura fabricada, com materia-prima,
// tintas, terceirizados e itens comerciais (telha, calha, rufo) — que e o que a LQC calcula.
//
// `composicao` guarda a entrada de cada aba (RESUMOS_EM, faturamento por grupo, precos, tintas,
// terceirizados, itens comerciais, BDI); `resultado` guarda o calculo da vez que gerou a proposta
// — sem isso, mudar um preco no futuro reescreveria a historia do que foi cotado.
model EstudoFabricacao {
  id            String   @id @default(cuid())
  numero        Int? // sequencial do ano → LQC-nnn-aa
  ano           Int
  revisao       Int      @default(0)
  cliente       String
  obra          String?
  orcamentoId   String? // liga ao Orcamento do pipeline comercial
  metodo        String   @default("ESTIMATIVA") // ESTIMATIVA | PESO DE PROJETO
  demaos        String? // 01 DEMAO | 02 DEMAOS | 03 DEMAOS | N/A
  preMontagem   String?
  composicao    Json     @default("{}")
  cenario       Json? // parametros do cenario financeiro (prazos, parcelas, taxa)
  resultado     Json? // ultimo calculo congelado
  status        String   @default("RASCUNHO")
  observacoes   String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ano])
  @@index([orcamentoId])
  @@index([status])
}

model OrcamentoServico {
  id            String   @id @default(cuid())
  numero        Int? // sequencial (OS-001)
  cliente       String
  obra          String?
  contato       String?
  email         String?
  telefone      String?
  endereco      String?
  servicos      Json     @default("[]")
  composicao    Json     @default("{}") // por serviço: { CORTE_FURACAO: { linhas: [...] }, ... }
  arquivos      Json     @default("[]") // arquivos do cliente: [{ url, nome, tamanho, tipo }]
  status        String   @default("RASCUNHO")
  valor         Float?
  observacoes   String?
  diasPagamento Int? // legado — usar pagamentoPrazo (texto livre)
  pagamentoPrazo String? // prazo de pagamento livre: "15", "28/42", "30/60"…
  inclusos      Json? // lista custom de inclusos (null = padrão)
  exclusos      Json? // lista custom de exclusos (null = padrão)
  lotes         Json? // lotes de entrega: [{ id, nome, local, data, itens:[{descricao,qtd,unidade}] }]
  revisao       Int      @default(0) // revisão atual (R00, R01…)
  revisoes      Json     @default("[]") // histórico: [{ num, data, motivo }]
  enviadoEm     DateTime? // 1º envio ao cliente
  envios        Json     @default("[]") // log de envios: [{ data, para, cc, revisao, porNome }]
  consolidadaEm DateTime? // proposta consolidada (trava edição; ganha tarja)
  aceiteToken   String?   @unique // token do link público de aceite do cliente
  aceiteEnviadoEm DateTime? // quando o link de aceite foi enviado
  aceitoEm      DateTime? // cliente aceitou/assinou
  aceitoNome    String? // nome de quem aceitou
  aceitoDoc     String? // RG/CPF de quem aceitou
  aceitoIp      String? // IP do aceite
  opCriadaId    String? // OP gerada a partir desta proposta aceita
  opId          String?
  criadoPorId   String?
  criadoPorNome String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([createdAt])
}

// Configuração de custo-hora por setor (Comercial) — base do "valor por hora"
// das propostas de serviço. Singleton (id="default"). setores = JSON
// [{ id, nome, empresa, faturaHora, salarios, mod, headcount, horasMes, cifDireto }].
// Overhead a ratear = folha dos setores que NÃO faturam (ADM) + outrosCustos
// (custos operacionais não-folha da DRE: material auxiliar, energia, gás, etc.).
model ConfigCustoHora {
  id                String   @id
  fatorEncargos     Float    @default(1.8)
  custoTotalMensal  Float?
  criterioRateio    String   @default("MOD") // MOD | HEADCOUNT | HORAS
  margemPct         Float    @default(30) // lucro sobre o custo
  impostosVendaPct  Float    @default(15) // ISS + PIS/COFINS sobre a venda (Lucro Real)
  horasDia          Float    @default(8.75) // jornada: horas/dia × dias × aproveitamento = horas/pessoa
  diasUteis         Float    @default(22)
  ocupacaoPct       Float    @default(8) // absenteísmo % (faltas) — horas = pessoas × hd × dias × (1 − ocupacaoPct/100)
  setores           Json     @default("[]")
  outrosCustos      Json     @default("[]") // overhead não-folha: [{ id, nome, valor }] (R$/mês)
  atualizadoPorNome String?
  updatedAt         DateTime @updatedAt @default(now())
}

// Portal da Qualidade — Módulo 1 (Controle de Documentos). Espelha o padrão dos
// documentos de RH (arquivo no Blob privado + backup ISO no SharePoint + proxy
// de download), com camada de VALIDAÇÃO da informação e amarração a norma +
// validade. Status (vigente/vencendo/vencido) é SEMPRE calculado (lib/qualidade-status).
model DocumentoQualidade {
  id               String    @id @default(cuid())
  nome             String
  categoria        String // EQUIPAMENTOS | FUNCIONARIOS | SISTEMA | INSPETORES
  tipo             String? // tipo específico (MTC, ASO, calibração, WPS...)
  norma            String? // AWS D1.1 · NR-35 · ISO 2808 · NBR 16775
  vinculo          String? // texto livre: OP-083 · Soldador João · Munck 01 · TORG
  opNumero         String? // vínculo estruturado opcional (alimenta o Data Book)
  numeroCorrida    String? // heat — certificados de material (rastreabilidade)
  numeroDocumento  String? // nº do certificado (ex.: importação CMR)
  fornecedor       String? // fornecedor do material (importação CMR)
  // Rastreabilidade/COMPRA vinda do CMR (planilha do Almoxarifado). Estruturado — antes ia tudo
  // como texto na observação e não dava pra somar/filtrar. Base do status de compra no PCP.
  pedidoCompra     String? // nº do pedido de compra / orçamento
  nfNumero         String? // nº da nota fiscal de entrada
  dataRecebimento  DateTime? // quando o material entrou (lançado no recebimento)
  pesoKg           Float? // peso recebido (kg) — soma por OP dá o total recebido
  quantidade       Float? // quantidade em peças (material contado por peça: tinta, parafuso…)
  importRef        String? // índice na planilha de origem (dedupe do import, em código)
  dataEmissao      DateTime?
  dataValidade     DateTime? // null = sem validade
  responsavel      String?
  observacao       String?
  origem           String    @default("registro_manual") // registro_manual | importacao_planilha
  // Validação da informação (camada de revisão antes de valer no data book)
  validado         Boolean   @default(false)
  validadoPorId    String?
  validadoEm       DateTime?
  // Arquivo (Vercel Blob privado) + backup ISO no SharePoint (mesmo padrão do RH)
  arquivoUrl       String?
  arquivoNome      String?
  arquivoTamanho   Int?
  arquivoTipo      String?
  sharepointUrl    String? // webUrl da cópia/origem no SharePoint
  sharepointItemId String? // item do SharePoint servido via proxy (1 PDF de faixa pode atender vários docs)
  ativo            Boolean   @default(true) // soft delete
  invalidadoMotivo String?
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Avaliação de calibração (só para certificados da categoria EQUIPAMENTOS) — 1:1
  avaliacaoCalibracao AvaliacaoCalibracao?

  @@index([categoria])
  @@index([dataValidade])
  @@index([opNumero])
  @@index([validado])
  @@index([ativo])
  @@index([importRef])
}

// Avaliação de um certificado de calibração (PO-20): parecer Aprovado/Reprovado
// por cima do certificado (DocumentoQualidade categoria EQUIPAMENTOS). Guarda os
// anexos obrigatórios (foto do equipamento + relatório) e os critérios avaliados.
model AvaliacaoCalibracao {
  id                  String    @id @default(cuid())
  numero              Int // sequencial RAC-001
  documentoId         String    @unique
  documento           DocumentoQualidade @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  // Identificação complementar do equipamento (o restante vem do documento/certificado)
  identificacao       String? // tag / patrimônio / nº de série
  faixaUso            String? // faixa de uso / medição do equipamento
  laboratorio         String? // laboratório que emitiu o certificado
  // Anexos obrigatórios para avaliar (Vercel Blob) — foto do equipamento + relatório
  fotoEquipamentoUrl  String?
  fotoEquipamentoNome String?
  relatorioUrl        String?
  relatorioNome       String?
  // Avaliação — critérios do PO-20 (editáveis) + parecer + conclusão
  criterios           Json      @default("[]") // [{ criterio, situacao: CONFORME|NAO_CONFORME|NA, observacao }]
  criterioAceitacao   String? // resumo do critério de aceitação (PO-20)
  parecer             String? // parecer final da avaliação
  conclusao           String    @default("PENDENTE") // PENDENTE | APROVADO | REPROVADO
  // Análise automática do certificado (IA) — pontos convertidos em %, padrões e rastreabilidade
  erroMaxPercent      Float? // limite de erro admissível (% do valor nominal); null = usar EMP do certificado
  analise             Json? // { laboratorio, acreditacao, faixaMin/Max, unidade, empDeclarado, incertezaMax, pontos:[{nominal,erro,unidade,incerteza,erroPercent,limitePercent,conforme}], padroes:[{nome,certificado,validade,vencido}], resumo, extraidoEm }
  analisadoEm         DateTime?
  avaliadorId         String?
  avaliadoEm          DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([conclusao])
}

// Portal da Qualidade — Módulo 2 (Data Book / dossiê de qualidade por OP).
// Uma por OP, com as 20 seções (template em lib/databook-secoes). Seções de
// fonte "modulo1" puxam documentos do Controle de Documentos pelo vínculo de OP.
model DataBookQualidade {
  id               String               @id @default(cuid())
  opNumero         String               @unique
  opId             String?
  cliente          String?
  obra             String?
  pesoTotalKg      Float?
  pecas            Int?
  tipo             String? // herda de OP.tipoDataBook: PADRAO_TORG | SNQC | RELATORIO_ACOMPANHAMENTO
  observacao       String?
  status           String               @default("EM_MONTAGEM") // EM_MONTAGEM | EMITIDO | ENVIADO_CLIENTE | ACEITO
  emitidoEm        DateTime?
  // REVISÃO. Vitor (19/08/2026): "sempre depois de emitido você não deve permitir salvar sem gerar
  // uma revisão; e se for revisão, fazer o histórico da revisão e enviar para assinatura de todos
  // novamente". R00 é a primeira emissão; cada mudança depois vira R01, R02…
  revisao          Int                  @default(0)
  revisoes         DataBookRevisao[]
  // Envio e aceite pelo cliente (link público por token, sem login)
  tokenCliente     String?              @unique
  clienteEmail     String?
  enviadoClienteEm DateTime?
  aceiteEm         DateTime?
  aceiteNome       String?
  aceiteIp         String?
  criadoPorId      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  secoes           DataBookSecao[]
  aprovacoes       DataBookAprovacao[]
  assinaturas      DataBookAssinatura[]
  arquivos         DataBookArquivo[]
  geracoes         DataBookGeracao[]

  @@index([opNumero])
}

// ─── O DATA BOOK COMO ARQUIVO, EM VOLUMES ─────────────────────────────────────
// Vitor (22/08/2026): "pode ser que teremos data books com até 10 mil páginas,
// precisamos ajustar isso já prevendo isso, até mesmo para o envio ao cliente".
//
// Até aqui o PDF era montado INTEIRO em memória a cada clique — inclusive no clique
// do cliente — dentro de uma função de 120 s. Isso tem teto: um livro de 10 mil
// páginas não cabe na memória de uma função nem termina no tempo dela, e o cliente
// não abre um arquivo de 3 GB no leitor de PDF dele.
//
// Passa a funcionar como data book de papel: um VOLUME por arquivo. O Volume 1 é o
// livro (capa, sumário, listas mestras, assinaturas); os volumes seguintes são os
// anexos, na ordem das seções. Cada volume é gerado, gravado no blob e nunca mais
// refeito — o data book é documento controlado: a R00 vale para sempre.
// ─── PLP — PLANO DE PINTURA DA OBRA ───────────────────────────────────────────
// Vitor (22/08/2026), olhando "Tipo de abrasivo" e "Rugosidade especificada (PLP)"
// em branco no relatório: "aqui já não podemos deixar definido? puxando do PLP de
// cada obra".
//
// O PO-05 item 3 define o PLP como "documento que define o sistema de pintura, método
// de preparação de superfície, tipos de tinta, número de demãos, espessuras, cores e
// critérios de inspeção". Ou seja: tudo que o relatório chama de ESPECIFICADO sai
// daqui — e por obra, não por procedimento.
//
// ⚠ SÓ O ESPECIFICADO. O que o inspetor MEDE (leituras de rugosidade e de espessura,
// lote, validade, condições do dia) continua nascendo em branco. Vitor já barrou o
// contrário uma vez: "esses números em vermelho não devem sair, o Inspetor é quem vai
// preencher essa informação".
model PlanoPintura {
  id             String   @id @default(cuid())
  opId           String?
  opNumero       String   @unique
  revisao        String? // revisão do PLP do cliente/projeto, como veio
  // preparação de superfície (PO-05 item 5.4)
  preparoMetodo  String? // Ferramentas manuais e/ou mecânicas | Jateamento abrasivo | Produtos químicos
  grauLimpeza    String? // ST2 | ST3 | SA1 | SA2 | SA2.5 | SA3 | QUIMICO
  abrasivo       String?
  rugosidadeMin  Float? // µm — PO-05 usa 50 a 90 quando o PLP não diz outra coisa
  rugosidadeMax  Float?
  // sistema de pintura
  metodoAplicacao String?
  // [{ ordem, nome, produto, fabricante, cor, espessuraMin, espessuraMax }]
  demaos         Json?
  // ⚠ AS CORES SÃO POR ITEM, NÃO POR DEMÃO. Vitor (22/08/2026): "temos peças que são de
  // cores diferentes, então o ideal seria criarmos a seleção e o Inspetor seleciona na
  // hora o que foi aplicado". Na PLP-T067 o mesmo sistema pinta plataformas de PRETO N1 e
  // guarda-corpo de AMARELO 5Y 8/12 — uma cor fixa no esquema estaria errada em metade
  // das peças. [{ item, sistema, cor, obs }], vindo da folha 3 do PLP.
  itens          Json?
  espessuraTotal Float? // µm, seca, do sistema todo
  // o PLP em si (PDF do cliente/projeto), quando houver
  arquivoUrl     String?
  arquivoNome    String?
  observacoes    String?
  criadoPorId    String?
  criadoPorNome  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([opNumero])
}

model DataBookArquivo {
  id           String            @id @default(cuid())
  dataBookId   String
  revisao      Int               @default(0)
  volume       Int // 1 = o livro; 2..N = anexos
  totalVolumes Int?
  titulo       String? // "Anexos · §02 Desenhos as-built (2 de 4)"
  url          String
  pathname     String?
  paginas      Int               @default(0)
  tamanho      Int               @default(0)
  geradoEm     DateTime          @default(now())
  dataBook     DataBookQualidade @relation(fields: [dataBookId], references: [id], onDelete: Cascade)

  @@unique([dataBookId, revisao, volume])
  @@index([dataBookId, revisao])
}

// A GERAÇÃO É UM JOB RETOMÁVEL. Nenhuma invocação serverless dá conta de 10 mil
// páginas: só o download dos anexos do SharePoint já passa de qualquer timeout. O job
// guarda um CURSOR sobre o roteiro de impressão e fecha um volume por invocação; o
// cron retoma de onde parou até acabar.
model DataBookGeracao {
  id           String            @id @default(cuid())
  dataBookId   String
  revisao      Int               @default(0)
  status       String            @default("NA_FILA") // NA_FILA | GERANDO | CONCLUIDO | ERRO | CANCELADO
  etapa        String?
  cursor       Int               @default(0) // posição no roteiro de impressão
  volumeAtual  Int               @default(0)
  totalVolumes Int               @default(0)
  totalItens   Int               @default(0)
  paginas      Int               @default(0)
  // ⚠ O QUE NÃO ENTROU TEM QUE APARECER. A trava antiga descartava anexo além da
  // página 200 em silêncio — o livro dizia ter 1.336 desenhos e levava 200 páginas
  // deles. Num documento controlado isso é pior que não gerar.
  pendencias   Json?
  // secaoId → { volumeIni, volumeFim, paginas }: onde os anexos de cada seção foram
  // parar. O Volume 1 (o livro) é gerado POR ÚLTIMO justamente para poder apontar isso.
  mapa         Json?
  erro         String?
  solicitadoPor String?
  criadoEm     DateTime          @default(now())
  iniciadoEm   DateTime?
  concluidoEm  DateTime?
  atualizadoEm DateTime          @updatedAt
  dataBook     DataBookQualidade @relation(fields: [dataBookId], references: [id], onDelete: Cascade)

  @@index([status, criadoEm])
  @@index([dataBookId])
}

// Cadeia sequencial de assinaturas do data book (assinatura digital por link/e-mail,
// sem login). Ordem: 1 Elaborador → 2 Inspetor → 3 Resp. Técnico → 4 Cliente.
// Cada etapa recebe um e-mail com link; ao assinar (digita o nome), envia a próxima.
// HISTÓRICO DE REVISÃO do data book — por que o documento mudou depois de emitido.
//
// Um data book emitido foi assinado e provavelmente entregue ao cliente. Se ele muda, o que o
// cliente tem na mão deixa de ser o que o portal mostra. A revisão é o que reconcilia isso: fica
// registrado o que mudou, quem mandou mudar e quando, e TODAS as assinaturas voltam a ser
// colhidas — quem assinou a R00 não assinou a R01.
model DataBookRevisao {
  id           String            @id @default(cuid())
  dataBookId   String
  revisao      Int // a revisão que NASCEU aqui (1 = R01)
  revisaoAnterior Int
  motivo       String // obrigatório: revisão sem motivo é mudança sem rastro
  statusAnterior String
  emitidoEmAnterior DateTime?
  assinaturasZeradas Int      @default(0)
  criadoPorId  String?
  criadoPorNome String?
  createdAt    DateTime          @default(now())
  dataBook     DataBookQualidade @relation(fields: [dataBookId], references: [id], onDelete: Cascade)

  @@index([dataBookId])
}

model DataBookAssinatura {
  id           String            @id @default(cuid())
  dataBookId   String
  ordem        Int // 1..4
  papel        String // ELABORADOR | INSPETOR | RESP_TECNICO | CLIENTE
  nome         String? // pré-preenchido (RT) ou definido na configuração
  email        String?
  token        String            @unique
  status       String            @default("PENDENTE") // PENDENTE | ENVIADO | ASSINADO
  enviadoEm    DateTime?
  assinadoEm   DateTime?
  assinadoNome String?
  ip           String?
  criadoEm     DateTime          @default(now())
  dataBook     DataBookQualidade @relation(fields: [dataBookId], references: [id], onDelete: Cascade)

  @@unique([dataBookId, ordem])
  @@index([dataBookId])
}

// Aprovação interna do data book (inspetor + envolvidos) antes do envio ao cliente.
model DataBookAprovacao {
  id         String            @id @default(cuid())
  dataBookId String
  userId     String?
  nome       String
  papel      String? // INSPETOR | QUALIDADE | RESP_TECNICO | OUTRO
  aprovadoEm DateTime          @default(now())
  dataBook   DataBookQualidade @relation(fields: [dataBookId], references: [id], onDelete: Cascade)

  @@unique([dataBookId, userId])
  @@index([dataBookId])
}

// Auditorias externas — registra a solicitação do cliente e os documentos que serão
// compartilhados com ele num portal público (link por token, sem login).
model Auditoria {
  id                 String         @id @default(cuid())
  empresa            String // empresa do cliente/auditor
  contato            String? // pessoa de contato no cliente
  titulo             String? // ex.: "Auditoria de Qualificação 2026"
  mensagemBoasVindas String?
  capaUrl            String? // foto de capa do hero do portal (Blob)
  dataBookModeloUrl  String? // PDF de Data Book modelo (exemplo p/ o cliente ver)
  checklistJson      Json? // status dos requisitos do GQ-FQ-003 { reqId: status } (legado; publicar hoje é por doc)
  itensAdicionais    Json           @default("[]") // evidências "pedido a mais": [{ id, titulo }] — docs ligam via requisito=id
  portalConfig       Json           @default("{}") // portal: { secoes:{estrutura,maquinas,equipe,modelo}, emailsCliente:[], emailsInternos:[] }
  solicitacoes       String? // o que o cliente pediu (texto / e-mail colado)
  // Relatório INTERNO da auditoria externa (apontamentos do auditor + plano de ação 5W2H
  // próprio + fotos + conclusão). NÃO vai ao portal do auditor — registro/resposta da Torg.
  numero             Int? // sequencial RAE-001
  dataAuditoria      DateTime?
  auditor            String? // auditor / certificadora que conduziu
  norma              String? // referência (ISO 9001, NBR 16775…)
  escopo             String?
  constatacoes       Json           @default("[]") // [{ tipo: CONFORME|NAO_CONFORME|MELHORIA, descricao }]
  planoAcao          Json           @default("[]") // 5W2H [{ oque, porque, onde, quem, quando, como, quanto, status, acompanhamento, concluidoEm }]
  fotos              Json           @default("[]") // [{ url, legenda }]
  conclusao          String?
  relatorioEmitidoEm DateTime?
  token              String?        @unique
  status             String         @default("RASCUNHO") // RASCUNHO | PUBLICADO
  publicadoEm        DateTime?
  clienteEmail       String?
  enviadoEmailEm     DateTime?
  primeiroAcessoEm   DateTime?
  ultimoAcessoEm     DateTime?
  criadoPorId        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  documentos         AuditoriaDoc[]

  @@index([status])
}

model AuditoriaDoc {
  id               String    @id @default(cuid())
  auditoriaId      String
  tipo             String    @default("EVIDENCIA") // SOLICITACAO (pedido do cliente) | EVIDENCIA (compartilhado)
  secao            String? // área do GQ-FQ-003 (aba no portal)
  requisito        String? // id do requisito/linha do GQ-FQ-003 (ou id de item adicional) que o documento atende
  nome             String
  arquivoUrl       String?
  arquivoTipo      String?
  arquivoTamanho   Int?
  sharepointItemId String?
  documentoId      String? // vínculo opcional a um DocumentoQualidade existente
  publicar         Boolean   @default(true) // mostra no portal do cliente (seleção por arquivo)
  comentario       String? // nota/evidência do que foi pedido (usado nos itens adicionais)
  createdAt        DateTime  @default(now())
  auditoria        Auditoria @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)

  @@index([auditoriaId])
}

// Auditoria INTERNA (a Torg auditando seus próprios setores) — cronograma +
// relatório enxuto divulgado ao setor por e-mail. NÃO confundir com Auditoria
// (externa: portal de documentos p/ certificadora/cliente). Requisito ISO 9001.
model AuditoriaInterna {
  id                        String    @id @default(cuid())
  numero                    Int // sequencial RAI-001
  setor                     String // setor/processo auditado
  dataAuditoria             DateTime
  responsavelAcompanhamento String // quem acompanha a auditoria pelo setor
  auditor                   String? // auditor (líder)
  norma                     String? // referência (ISO 9001, NBR 16775…)
  escopo                    String? // objetivo/escopo
  status                    String    @default("AGENDADA") // AGENDADA | REALIZADA | EMITIDO | FINALIZADO
  constatacoes              Json      @default("[]") // [{ tipo: CONFORME|NAO_CONFORME|MELHORIA, descricao }]
  acoes                     Json      @default("[]") // [{ oque, responsavel, prazo, resposta, evidencias:[{url,legenda}], concluida, respondidoEm }]
  fotos                     Json      @default("[]") // registro fotográfico [{ url, legenda }]
  conclusao                 String?
  divulgadoEm               DateTime?
  finalizadoEm              DateTime? // encerrado após todas as ações do plano concluídas
  divulgadoPara             Json      @default("[]") // histórico [{ email, em }]
  createdById               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([status])
  @@index([dataAuditoria])
}

// Plano de Ação 5W2H (Qualidade) — ações com O quê/Por quê/Onde/Quem/Quando/
// Como/Quanto, com acompanhamento e status por ação. Pode nascer de auditoria,
// não-conformidade, reclamação, reunião etc. (campo origem, texto livre).
model PlanoAcao {
  id          String   @id @default(cuid())
  numero      Int // PA-001
  titulo      String
  origem      String? // de onde veio (Auditoria RAI-001, NC, reclamação…)
  responsavel String? // dono do plano
  status      String   @default("EM_ANDAMENTO") // EM_ANDAMENTO | CONCLUIDO | CANCELADO
  itens       Json     @default("[]") // [{ oque, porque, onde, quem, quando, como, quanto, status, acompanhamento, concluidoEm }]
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// Relatório de Não Conformidade (RNC / FORM 20). tipo INTERNA (Torg detecta) ou
// CLIENTE (o cliente envia um RTNC que anexamos e a IA converte). Alimenta os
// indicadores RNCs do Cliente, Erros de Projeto e Recorrência de NC.
model NaoConformidade {
  id                  String    @id @default(cuid())
  numero              Int // sequencial por ano
  ano                 Int
  tipo                String // INTERNA | CLIENTE
  data                DateTime // abertura
  // Identificação
  cliente             String?
  opNumero            String? // T69
  opId                String?
  desenhoProjetoMarca String?
  origem              String? // PROCESSO | PRODUTO | CLIENTE | FORNECEDOR | AUDITORIA_INTERNA | AUDITORIA_EXTERNA | INDICADOR
  fornecedor          String?
  processoArea        String? // setor/área da ocorrência (Expedição, Engenharia…)
  descricao           String?
  fotos               Json      @default("[]") // registro fotográfico [{ url, legenda }]
  anexos              Json      @default("[]") // anexos p/ compor o relatório [{ url, nome, tipo }] (imagens/PDF/docs)
  disposicao          String? // APROVAR_CONCESSAO | RETRABALHAR | REFUGAR | DEVOLVER_FORNECEDOR
  pesoRetrabalhoKg    Float? // peso retrabalhado (kg) — base do indicador de Retrabalho da Produção
  elaborador          String?
  resultadoReinspecao String?
  abrangencia         String?
  necessitaAcao       String? // CORRETIVA | PREVENTIVA | NAO_NECESSARIO
  motivoNaoAcao       String?
  causas              String?
  cincoPorques        Json      @default("[]") // análise de causa raiz [{ porque, resposta }]
  planoAcaoId         String? // liga ao 5W2H (PlanoAcao)
  prazoResposta       DateTime?
  realizadoEm         DateTime?
  acompanhadoPor      String?
  acompanhamento      String?
  avaliacaoEficacia   String?
  encerradaPor        String?
  encerradaEm         DateTime?
  status              String    @default("ABERTA") // ABERTA | EM_ACAO | RESPONDIDA | ENCERRADA
  // Indicadores
  pertinente          Boolean   @default(true) // conta no indicador de RNCs do cliente
  recorrente          Boolean   @default(false)
  rncAnteriorId       String?
  // ⚠ RNC ABERTA POR REPROVAÇÃO DE INSPEÇÃO. Vitor (21/08/2026): "no caso do relatório reprovado
  // deverá já ser aberta uma RNC inclusive". O vínculo é nos dois sentidos: daqui se chega ao
  // relatório que reprovou, e de lá à RNC que a reprovação gerou.
  relatorioInspecaoId String?

  // RNC de Cliente (RTNC)
  anexoUrl            String? // documento da RNC do cliente
  programa            String? // ASME…
  jobCliente          String? // 0326
  numeroCliente       String? // RTNC-010
  respostaCliente     String? // texto da resposta gerada
  respostaPdfUrl      String?
  respostaEnviadaEm   DateTime?
  evidencias          Json      @default("[]") // [{ tipo, descricao, url }] treinamentos/melhorias
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tipo])
  @@index([status])
  // ⚠ ÚNICO, não só índice: duas RNCs abertas no mesmo instante liam o mesmo "último número" e
  // gravavam o mesmo. Passou a existir risco real quando a reprovação de inspeção começou a abrir
  // RNC sozinha — dois inspetores reprovando ao mesmo tempo, no chão de fábrica, é rotina.
  @@unique([ano, numero])
  @@index([ano, numero])
}

// ── Portal de Apresentação ao Cliente (Compras) ──────────────────
// Biblioteca fixa de documentos institucionais da Torg (cadastra 1x, reusa em
// toda apresentação): cadastrais, portfólio, etc.
model DocumentoInstitucional {
  id             String   @id @default(cuid())
  tipo           String   @default("CADASTRAL") // CADASTRAL | PORTFOLIO | OUTRO
  nome           String
  arquivoUrl     String
  arquivoTipo    String?
  arquivoTamanho Int?
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  criadoPorId    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tipo])
  @@index([ativo])
}

// Página de apresentação personalizada por cliente (link público por token).
// ─── PORTAL DO CLIENTE ────────────────────────────────────────────────────────
// Vitor (22/08/2026): "vamos fazer o painel do cliente; nesse painel vamos fornecer
// documentos, listas de compras, cronograma, LPC, LE, certificados de qualidade,
// relatórios — tudo que for de interesse nosso em mostrar e que seja interesse dele
// receber... uma mensagem forte de agradecimento e parceria, mostrando o lado de
// preocupação que carregamos em atender os mais altos padrões de qualidade".
//
// É o fecho do que o portal vinha construindo: cada módulo já sabe o que a obra tem —
// cronograma, LPC, certificados, relatórios aprovados, data book. O que faltava era um
// lugar onde o CLIENTE vê isso sem pedir por e-mail.
//
// ⚠ UM POR OBRA, e por isso `opNumero` é único. Portal é endereço: mudar de link a cada
// envio faria o cliente perder o que já tinha salvo.
//
// ⚠ E O QUE APARECE É ESCOLHA NOSSA, seção por seção (`secoes`). Nem toda obra quer
// mostrar tudo — e um portal que expõe algo que o contrato não previu é problema, não
// cortesia.
// ─── O QUE O CLIENTE JA VIU DA LPC E DA LE ────────────────────────────────────
// Vitor (22/08/2026): "a LE e LPC deve ter permissao para o cliente baixar e nos casos de uma
// revisao disponibilizar uma lista nova para Download, informa a revisao atual e deixar com um
// alerta quando ele entrar para saber o que mudou".
//
// ⚠ NAO DA PRA CONTAR "O QUE MUDOU" SEM GUARDAR O QUE ELE VIU. A LPC e a LE vivem na
// PecaConjunto, que so tem o estado de AGORA: quando a engenharia reimporta, o que existia antes
// simplesmente deixa de existir. Sem esta foto, a unica coisa honesta a dizer ao cliente seria
// "a lista mudou" — que e o mesmo que nao dizer nada, porque ele teria de conferir marca por
// marca de novo. Cada linha e uma revisao publicada: a impressao digital das marcas na epoca e o
// diff contra a anterior.
//
// A foto e tirada quando o cliente abre o portal e o conteudo difere da ultima — nao ha cron, e
// nao ha janela em que o portal mostre uma lista que ninguem registrou.
// ─── TRATATIVA DE RASTREABILIDADE (por R) ─────────────────────────────────────
// Vitor (22/08/2026): "o que precisamos garantir e que todos os materiais listados para as ops
// estejam com as informacoes em dia... alguns materiais usamos de estoque".
//
// ⚠ NEM TODA PENDENCIA SE RESOLVE BUSCANDO O ARQUIVO. Material que saiu do estoque nao gera
// certificado novo: o certificado dele e o da compra ORIGINAL, com outro R. Sem um lugar para
// registrar isso, esses itens ficariam vermelhos para sempre e a tela viraria ruido — que e
// exatamente o que faz uma conferencia deixar de ser usada.
//
// ⚠ E O VOCABULARIO E FECHADO, DE PROPOSITO. Vitor: "nao podemos em hipotese alguma mencionar
// que o fornecedor nao entrega certificado". Registrar isso seria deixar escrito, num documento
// que auditor e cliente podem ler, que a Torg recebeu material sabendo que o certificado nao
// viria. As situacoes possiveis descrevem ONDE o certificado esta (estoque, arquivo fisico) ou
// que ele ainda nao chegou — nunca uma decisao de dispensar certificado. Ver lib/rastreio-tratativa.
model RastreioTratativa {
  id              String   @id @default(cuid())
  importRef       String   @unique // o R do material no CMR
  opNumero        String?
  // ESTOQUE | ARQUIVO_FISICO | AGUARDANDO_CERTIFICADO — lista fechada em lib/rastreio-tratativa.js
  situacao        String
  // Caso ESTOQUE: o R da compra original, de onde vem o certificado deste material.
  rOrigem         String?
  observacao      String?
  registradoPorId String?
  registradoEm    DateTime @default(now())
