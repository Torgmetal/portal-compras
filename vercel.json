{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)docs' ':(exclude)testes' ':(exclude)*.md' ':(exclude)versao-build.json'",
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "(?!workspace\\.torg\\.com\\.br$).*\\.vercel\\.app$"
        }
      ],
      "destination": "https://workspace.torg.com.br/:path",
      "permanent": true
    }
  ],
  "functions": {
    "app/api/qualidade/documentos/importar/route.js": {
      "memory": 3009
    },
    "app/api/rh/holerite/preparar/route.js": {
      "memory": 3009
    },
    "app/api/relatorios/[id]/pdf/route.js": {
      "memory": 3009
    },
    "app/api/relatorio/aceite/[token]/pdf/route.js": {
      "memory": 3009
    },
    "app/api/portal/[token]/eng-zip/route.js": {
      "memory": 3009,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/estoque-produtos",
      "schedule": "0 6-20 * * *"
    },
    {
      "path": "/api/cron/estoque-movimentacoes",
      "schedule": "30 6-20 * * *"
    },
    {
      "path": "/api/producao/sync-sharepoint",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/sync-entregas",
      "schedule": "0 8,11,14,17 * * *"
    },
    {
      "path": "/api/cron/faturamento",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/financeiro",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/qualidade-vencidos",
      "schedule": "0 11 * * 1"
    },
    {
      "path": "/api/cron/reconciliar-syneco-corte",
      "schedule": "15 6-20 * * *"
    },
    {
      "path": "/api/qualidade/cmr/sincronizar",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/compras/produtos-omie/sincronizar",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/monitor",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/emails-engenharia",
      "schedule": "45 6-20 * * *"
    },
    {
      "path": "/api/cron/data-book",
      "schedule": "15 10-21 * * 1-5"
    },
    {
      "path": "/api/cron/rnc-abertas",
      "schedule": "0 8 * * 1-5"
    },
    {
      "path": "/api/cron/sync-fornecedores-omie",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron/cmr-reconciliar",
      "schedule": "40 5,13 * * *"
    },
    {
      "path": "/api/cron/omie-encerrados",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/cron/pasta-engenharia",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/backup-banco",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/backup-arquivos",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/engenharia/grd/sincronizar",
      "schedule": "0 11,17,21 * * 1-5"
    },
    {
      "path": "/api/comercial/orcamento/importar-sharepoint",
      "schedule": "20 6-20 * * 1-5"
    },
    {
      "path": "/api/comercial/estudos/importar-sharepoint",
      "schedule": "40 6-20 * * 1-5"
    },
    {
      "path": "/api/cron/casar-certificados",
      "schedule": "50 5,13 * * *"
    },
    {
      "path": "/api/cron/conferir-listas",
      "schedule": "0 10 * * 1-5"
    },
    {
      "path": "/api/cron/fiscal-tipi",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/fiscal-legislacao",
      "schedule": "40 4 * * 1"
    }
  ]
}
